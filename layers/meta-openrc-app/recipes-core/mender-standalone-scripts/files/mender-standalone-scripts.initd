depend() {
    need volatiles 
}

start() {
    ebegin "Staring mender-standalone-scripts"
    /usr/sbin/mender-standalone-scripts ArtifactReboot_Leave
    eend 0
}

stop() { 
    ebegin "Stopping mender-standalone-scripts"
    eend 0
}
