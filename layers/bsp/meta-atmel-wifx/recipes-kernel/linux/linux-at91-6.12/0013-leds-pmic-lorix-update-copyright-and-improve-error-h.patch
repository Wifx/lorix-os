From 76ccc7ab302c2510053026ab1a967312df106ea3 Mon Sep 17 00:00:00 2001
From: Yannick Serafini <yannick.serafini@wifx.net>
Date: Tue, 3 Mar 2026 09:57:03 +0100
Subject: [PATCH 13/13] leds: pmic-lorix: update copyright and improve error
 handling in probe function

---
 drivers/leds/leds-pmic-lorix.c | 21 +++++++++++----------
 1 file changed, 11 insertions(+), 10 deletions(-)

diff --git a/drivers/leds/leds-pmic-lorix.c b/drivers/leds/leds-pmic-lorix.c
index 4ee8a081c460..aa604f1ecfb7 100644
--- a/drivers/leds/leds-pmic-lorix.c
+++ b/drivers/leds/leds-pmic-lorix.c
@@ -1,13 +1,10 @@
+// SPDX-License-Identifier: GPL-2.0
 /*
  * LEDs driver for the LORIX One PMIC/Reset controller
  *
- *  Copyright (C) 2016 Wifx,
- *                2016 Yannick Lanz <yannick.lanz@wifx.net>
- *
- * This program is free software; you can redistribute it and/or modify
- * it under the terms of the GNU General Public License version 2 as
- * published by the Free Software Foundation.
- *
+ * Copyright (C) 2016 Wifx SA,
+ *               2016 Yannick Lanz <yannick.lanz@wifx.net>
+ *               2026 Yannick Serafini <yannick.serafini@wifx.net>
  */
 #include <linux/module.h>
 #include <linux/kernel.h>
@@ -135,8 +132,11 @@ static int __init attiny_led_probe(struct platform_device *pdev)
 
 	if (dev->parent->of_node) {
 		pdata = attiny_led_probe_dt(pdev);
-		if (IS_ERR(pdata))
+		if (IS_ERR(pdata)) {
+			dev_err(dev, "failed to parse LED DT data: %ld\n",
+				PTR_ERR(pdata));
 			return PTR_ERR(pdata);
+		}
 	} else if (!pdata)
 		return -ENODATA;
 
@@ -183,7 +183,7 @@ static int __init attiny_led_probe(struct platform_device *pdev)
 			break;
 		} else {
 			dev_info(dev,
-				 "registred led (name = %s, trigger = %s)\n",
+				 "registered led (name = %s, trigger = %s)\n",
 				 name, trig);
 		}
 	}
@@ -223,10 +223,11 @@ static struct platform_driver attiny_led_driver = {
 		.name	= "pmic-lorix-led",
 		.of_match_table = of_match_ptr(pmic_lorix_led_of_match),
 	},
+	.probe = attiny_led_probe,
 	.remove   = attiny_led_remove,
 };
 
-module_platform_driver_probe(attiny_led_driver, attiny_led_probe);
+module_platform_driver(attiny_led_driver);
 
 MODULE_AUTHOR("Yannick Lanz <yannick.lanz@wifx.net>");
 MODULE_DESCRIPTION("LORIX One Status LED");
-- 
2.43.0

