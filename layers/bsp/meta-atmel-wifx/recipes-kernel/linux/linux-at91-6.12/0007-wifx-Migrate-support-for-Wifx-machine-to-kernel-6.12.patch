-		if (status < 0)
-			return status;
-
-		if (status == CMD_LTR_STATUS_SUCCESS)
-			return 0;
-
-		if (status == CMD_LTR_STATUS_BUSY) {
-			msleep(5);
-			continue;
-		}
-
-		dev_err(ec->dev, "LTR command error status: %d\n", status);
-		return -EIO;
-	}
-	return -EBUSY;
-}
