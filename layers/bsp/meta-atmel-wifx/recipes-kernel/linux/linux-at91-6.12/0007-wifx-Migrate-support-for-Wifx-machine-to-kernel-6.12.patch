+
+static int wifx_drd_apply_role_locked(struct wifx_drd_glue *glue,
+				      enum typec_data_role new_data_role, 
+				      bool attached)
+{
+	enum usb_role udc_role;
+	bool role_changed = (glue->data_role != new_data_role) ||
+			   (glue->attached != attached);
+	bool bound_now = false;
+	int ret = 0;
+
+	//udc_role = wifx_drd_map_role_to_udc(new_role);
+
+	/* Lazy discovery: try to bind to the UDC if not already done */
+	if (!glue->role_sw_out) {
+		glue->role_sw_out = wifx_drd_get_output_switch(glue);
+	} else {
+		bound_now = true;
+	}
+
+	if (glue->role_sw_out && (role_changed || bound_now)) {
+		/* USB-C to UDC mapping logic */
+		if (new_data_role == TYPEC_HOST)
+			udc_role = USB_ROLE_NONE; /* In host mode, UDC should be detached */
+		else {
+			udc_role = USB_ROLE_DEVICE; /* In device mode, UDC should be active */
+		}
+		ret = usb_role_switch_set_role(glue->role_sw_out, udc_role);
+		if (ret)
+			return ret;
+	} else {
+		dev_dbg(glue->dev, "UDC role switch not yet available (lazy discovery)\n");
+		schedule_delayed_work(&glue->udc_retry_work,
+					msecs_to_jiffies(500));
+	}
+
+	if (role_changed) {
+		dev_info(glue->dev, "role change: %d -> %d\n",
+			 glue->data_role,
+			 new_data_role);
+		glue->data_role = new_data_role;
+		glue->attached = attached;
+	}
+	return 0;
+}
