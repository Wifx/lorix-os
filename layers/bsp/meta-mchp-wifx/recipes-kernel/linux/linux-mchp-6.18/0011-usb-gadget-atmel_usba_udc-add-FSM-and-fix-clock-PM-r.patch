From 596abc0e24349fb21b22577ff0db58c4de4d49bb Mon Sep 17 00:00:00 2001
From: Yannick Serafini <yannick.serafini@wifx.net>
Date: Thu, 5 Mar 2026 14:12:32 +0100
Subject: [PATCH 11/13] usb: gadget: atmel_usba_udc: add FSM and fix clock/PM
 races

Replace ad-hoc suspended/shutting_down flags and dual
state_lock/clock_lock with a small controller FSM
(UNINIT/ACTIVE/SUSPENDED/STOPPED) plus a single pm_mutex to
serialize start/stop, VBUS, role-switch and PM paths.

All stop callers now use usba_stop_locked(), which masks and clears
UDC interrupts, resets endpoints, detaches, then gates clocks/PHY and
sets the FSM to STOPPED. The delayed IRQ worker drops events once
STOPPED and only gates clocks on suspend when the gadget is already
logically disconnected, avoiding hard lockups on rmmod/modprobe
cycles. Also fix the EP0 descriptor to use EP0_FIFO_SIZE and
bInterval = 0.

Signed-off-by: Yannick Serafini <yannick.serafini@wifx.net>
---
 drivers/usb/gadget/udc/atmel_usba_udc.c | 378 ++++++++++++++----------
 drivers/usb/gadget/udc/atmel_usba_udc.h |  20 +-
 2 files changed, 241 insertions(+), 157 deletions(-)

diff --git a/drivers/usb/gadget/udc/atmel_usba_udc.c b/drivers/usb/gadget/udc/atmel_usba_udc.c
index 5bd55a9c47c1..9172c1d8a42d 100644
--- a/drivers/usb/gadget/udc/atmel_usba_udc.c
+++ b/drivers/usb/gadget/udc/atmel_usba_udc.c
@@ -41,6 +41,132 @@ enum {
 #define USBA_IRQ_CLOCK_EVT_SUSPEND BIT(USBA_IRQ_CLOCK_EVT_SUSPEND_BIT)
 #define USBA_IRQ_CLOCK_EVT_WAKEUP BIT(USBA_IRQ_CLOCK_EVT_WAKEUP_BIT)
 
+enum usba_event {
+	USBA_EVENT_NONE = 0,
+	USBA_EVENT_SUSPEND,
+	USBA_EVENT_WAKEUP,
+	USBA_EVENT_RESUME,
+	USBA_EVENT_START,
+	USBA_EVENT_STOP,
+	USBA_EVENT_RESET,
+};
+
+#if defined(DEBUG)
+static const char *usba_event_name(enum usba_event event)
+{
+	switch (event) {
+	case USBA_EVENT_NONE:
+		return "none";
+	case USBA_EVENT_SUSPEND:
+		return "suspend";
+	case USBA_EVENT_WAKEUP:
+		return "wakeup";
+	case USBA_EVENT_RESUME:
+		return "resume";
+	case USBA_EVENT_START:
+		return "start";
+	case USBA_EVENT_STOP:
+		return "stop";
+	case USBA_EVENT_RESET:
+		return "reset";
+	default:
+		return "unknown";
+	}
+}
+
+static const char *usba_state_name(enum usba_state state)
+{
+	switch (state) {
+	case USBA_STATE_UNINIT:
+		return "uninit";
+	case USBA_STATE_ACTIVE:
+		return "active";
+	case USBA_STATE_SUSPENDED:
+		return "suspended";
+	case USBA_STATE_STOPPED:
+		return "stopped";
+	default:
+		return "unknown";
+	}
+}
+#endif
+
+static inline enum usba_state usba_get_state(struct usba_udc *udc)
+{
+	return READ_ONCE(udc->state);
+}
+
+static bool usba_can_transition(struct usba_udc *udc,
+				   enum usba_state new_state,
+				   enum usba_event event)
+{
+	enum usba_state cur = usba_get_state(udc);
+
+	/*
+	 * Keep policy intentionally simple for now: only block
+	 * obviously nonsensical transitions to catch logic bugs
+	 * without constraining valid runtime flows.
+	 */
+	switch (cur) {
+	case USBA_STATE_UNINIT:
+		/* probe() may set ACTIVE directly, STOPPED is used on remove */
+		return new_state == USBA_STATE_ACTIVE ||
+		       new_state == USBA_STATE_STOPPED;
+	case USBA_STATE_ACTIVE:
+		/* ACTIVE can go to SUSPENDED or STOPPED */
+		return new_state == USBA_STATE_ACTIVE ||
+		       new_state == USBA_STATE_SUSPENDED ||
+		       new_state == USBA_STATE_STOPPED;
+	case USBA_STATE_SUSPENDED:
+		/* SUSPENDED can resume to ACTIVE or be fully stopped */
+		return new_state == USBA_STATE_SUSPENDED ||
+		       new_state == USBA_STATE_ACTIVE ||
+		       new_state == USBA_STATE_STOPPED;
+	case USBA_STATE_STOPPED:
+		/*
+		 * STOPPED is normally terminal, but an explicit START event
+		 * (e.g. role switch back to device) is allowed to restart
+		 * the controller.
+		 */
+		if (new_state == USBA_STATE_ACTIVE && event == USBA_EVENT_START)
+			return true;
+		return new_state == USBA_STATE_STOPPED;
+	}
+
+	return false;
+}
+
+static void usba_set_state(struct usba_udc *udc,
+			   enum usba_state new_state,
+			   enum usba_event event)
+{
+	enum usba_state old = usba_get_state(udc);
+
+	if (old == new_state)
+		return;
+	if (!usba_can_transition(udc, new_state, event)) {
+#if defined(DEBUG)
+		dev_warn(&udc->pdev->dev,
+			 "invalid state transition: %s -> %s (event=%s)\n",
+			 usba_state_name(old), usba_state_name(new_state),
+			 usba_event_name(event));
+#else
+		dev_warn(&udc->pdev->dev,
+			 "invalid state transition: %d -> %d (event=%d)\n",
+			 old, new_state, event);
+#endif
+		return;
+	}
+
+	udc->state = new_state;
+#if defined(DEBUG)
+	dev_dbg(&udc->pdev->dev,
+		"state: %s -> %s (event=%s)\n",
+		usba_state_name(old), usba_state_name(new_state),
+		usba_event_name(event));
+#endif
+}
+
