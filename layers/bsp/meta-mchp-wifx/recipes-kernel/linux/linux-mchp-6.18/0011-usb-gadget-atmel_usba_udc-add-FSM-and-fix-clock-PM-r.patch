-static int start_clock(struct usba_udc *udc);
-static void stop_clock(struct usba_udc *udc);
+static int start_clock_locked(struct usba_udc *udc);
+static void stop_clock_locked(struct usba_udc *udc);
 
 static void usba_udc_irq_delayed(struct work_struct *work)
 {
@@ -1745,38 +1871,41 @@ static void usba_udc_irq_delayed(struct work_struct *work)
 	unsigned long flags;
 
 	/*
-	 * Single shutdown gate under state_lock: if remove() started before this
-	 * worker run, pending delayed IRQ events are dropped and no clock/PHY
-	 * transition is performed while teardown is in progress.
+	 * Serialize late clock/PHY updates against remove() via pm_mutex.
+	 * If remove() set the state to STOPPED, drop pending events and
+	 * return without touching clocks/PHY during teardown.
 	 */
-	mutex_lock(&udc->state_lock);
+	mutex_lock(&udc->pm_mutex);
 	spin_lock_irqsave(&udc->lock, flags);
 	events = xchg(&udc->udc_irq_delayed_events, 0);
 	spin_unlock_irqrestore(&udc->lock, flags);
-	if (READ_ONCE(udc->shutting_down)) {
-		mutex_unlock(&udc->state_lock);
+	if (usba_get_state(udc) == USBA_STATE_STOPPED) {
+		mutex_unlock(&udc->pm_mutex);
 		return;
 	}
 
 	if (events & USBA_IRQ_CLOCK_EVT_WAKEUP) {
-		start_clock(udc);
+		start_clock_locked(udc);
 		toggle_bias(udc, 1);
 	} else if (events & USBA_IRQ_CLOCK_EVT_SUSPEND) {
-		if (!READ_ONCE(udc->suspended))
+		if (usba_get_state(udc) != USBA_STATE_SUSPENDED)
 			goto out;
 
 		/*
-		 * Regression fix: when gadget is active, stopping clocks on
-		 * cable unplug suspend can lock up the system. Keep clocks
-		 * running in this case and let explicit stop paths
-		 * (role none/udc stop/remove) gate clocks.
+		 * On suspend, always drop bias and schedule a bias pulse for the
+		 * next resume/reset. To avoid lockups when the gadget is still
+		 * active, leave clocks running and let explicit stop paths
+		 * (role none / udc stop / remove) gate clocks; only gate them
+		 * here when the gadget is already logically disconnected.
 		 */
+		toggle_bias(udc, 0);
+		udc->bias_pulse_needed = true;
 		if (udc->gadget.speed == USB_SPEED_UNKNOWN || !udc->driver)
-			stop_clock(udc);
+			stop_clock_locked(udc);
 	}
 
 out:
-	mutex_unlock(&udc->state_lock);
+	mutex_unlock(&udc->pm_mutex);
 }
 
