@@ -1792,24 +1921,11 @@ static irqreturn_t usba_udc_irq(int irq, void *devid)
 	status = usba_readl(udc, INT_STA) & (int_enb | USBA_HIGH_SPEED);
 	DBG(DBG_INT, "irq, status=%#08x\n", status);
 
-	if (unlikely(READ_ONCE(udc->shutting_down))) {
-		/*
-		 * remove() is in progress: do not execute normal IRQ logic.
-		 * Only ack pending interrupt sources to avoid IRQ retriggering.
-		 */
-		if (status)
-			usba_writel(udc, INT_CLR, status & ~USBA_HIGH_SPEED);
-		spin_unlock(&udc->lock);
-		return IRQ_HANDLED;
-	}
-
 	if (status & USBA_DET_SUSPEND) {
 		usba_writel(udc, INT_CLR, USBA_DET_SUSPEND | USBA_WAKE_UP);
 		usba_int_enb_set(udc, USBA_WAKE_UP);
 		usba_int_enb_clear(udc, USBA_DET_SUSPEND);
-		udc->suspended = true;
-		toggle_bias(udc, 0);
-		udc->bias_pulse_needed = true;
+		usba_set_state(udc, USBA_STATE_SUSPENDED, USBA_EVENT_SUSPEND);
 		set_bit(USBA_IRQ_CLOCK_EVT_SUSPEND_BIT,
 			&udc->udc_irq_delayed_events);
 		schedule_delayed_work(&udc->udc_irq_delayed_work, 0);
@@ -1833,7 +1949,7 @@ static irqreturn_t usba_udc_irq(int irq, void *devid)
 	}
 
 	if (status & USBA_END_OF_RESUME) {
-		udc->suspended = false;
+		usba_set_state(udc, USBA_STATE_ACTIVE, USBA_EVENT_RESUME);
 		usba_writel(udc, INT_CLR, USBA_END_OF_RESUME);
 		usba_int_enb_clear(udc, USBA_WAKE_UP);
 		usba_int_enb_set(udc, USBA_DET_SUSPEND);
@@ -1908,7 +2024,7 @@ static irqreturn_t usba_udc_irq(int irq, void *devid)
 				USBA_EPT_ENABLE | USBA_RX_SETUP);
 
 		/* If we get reset while suspended... */
-		udc->suspended = false;
+		usba_set_state(udc, USBA_STATE_ACTIVE, USBA_EVENT_RESET);
 		usba_int_enb_clear(udc, USBA_WAKE_UP);
 
 		usba_int_enb_set(udc, USBA_BF(EPT_INT, 1) |
@@ -1944,14 +2060,12 @@ static irqreturn_t usba_udc_irq(int irq, void *devid)
 	return IRQ_HANDLED;
 }
 
