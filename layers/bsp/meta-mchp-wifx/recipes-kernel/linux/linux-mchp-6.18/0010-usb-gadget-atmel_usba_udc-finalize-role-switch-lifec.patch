 static void usba_force_disconnect_pulse_locked(struct usba_udc *udc,
-					     bool final_mux_host)
+							 bool final_mux_host)
 {
+	/*
+	 * Some hosts do not always detect a pure DETACH/PULLD_DIS transition.
+	 * Force a short physical break by switching mux to host briefly, then
+	 * restore the requested mux state.
+	 */
