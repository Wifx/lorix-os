 static void stop_clock(struct usba_udc *udc)
 {
+	mutex_lock(&udc->clock_lock);
+
 	if (!udc->clocked)
-		return;
+		goto out;
+
+	udc->clocked = false;
 
 	clk_disable_unprepare(udc->hclk);
 	clk_disable_unprepare(udc->pclk);
 
 	phy_power_off(udc->phy);
 
-	udc->clocked = false;
+	WRITE_ONCE(udc->clocked, false);
 
 	pm_relax(&udc->pdev->dev);
+out:
+	mutex_unlock(&udc->clock_lock);
 }
 
