+		udc->suspended,
+		usb_role_string(READ_ONCE(udc->role_sw_current)));
 
 	if (udc->suspended)
 		return;
 
 	spin_lock_irqsave(&udc->lock, flags);
+	/*
+	 * Quiesce all UDC interrupt sources before endpoint/clock teardown.
+	 * This prevents stale endpoint/DMA/status IRQ handling while clocks are
+	 * being gated during stop/unbind/remove paths.
+	 */
