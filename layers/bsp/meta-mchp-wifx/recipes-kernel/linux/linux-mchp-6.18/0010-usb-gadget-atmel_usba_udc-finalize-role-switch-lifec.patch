@@ -1735,19 +1744,38 @@ static void usba_udc_irq_delayed(struct work_struct *work)
 	unsigned long events;
 	unsigned long flags;
 
+	/*
+	 * Single shutdown gate under state_lock: if remove() started before this
+	 * worker run, pending delayed IRQ events are dropped and no clock/PHY
+	 * transition is performed while teardown is in progress.
+	 */
 	mutex_lock(&udc->state_lock);
 	spin_lock_irqsave(&udc->lock, flags);
 	events = xchg(&udc->udc_irq_delayed_events, 0);
 	spin_unlock_irqrestore(&udc->lock, flags);
+	if (READ_ONCE(udc->shutting_down)) {
+		mutex_unlock(&udc->state_lock);
+		return;
+	}
 
-	if (events & BIT(USBA_IRQ_CLOCK_EVT_WAKEUP_BIT)) {
+	if (events & USBA_IRQ_CLOCK_EVT_WAKEUP) {
