 	usleep_range(USBA_DISCONNECT_PULSE_US_MIN,
 		     USBA_DISCONNECT_PULSE_US_MAX);
@@ -2068,74 +2181,129 @@ static void usba_force_disconnect_pulse_locked(struct usba_udc *udc,
 
 static void usba_apply_role_none_locked(struct usba_udc *udc, bool mux_host)
 {
+	unsigned long flags;
+
+	dev_dbg(&udc->pdev->dev, "role-apply: none begin (mux_host=%d)\n", mux_host);
+	
+	/*
+	 * Drop stale delayed IRQ events before forcing role=none.
+	 * Otherwise a queued suspend/wakeup event from the previous role can be
+	 * replayed later by the worker and race with explicit stop/mux/phy changes.
+	 */
+	spin_lock_irqsave(&udc->lock, flags);
+	udc->udc_irq_delayed_events = 0;
+	spin_unlock_irqrestore(&udc->lock, flags);
+
 	udc->suspended = false;
 
+	/*
+	 * Notify gadget framework when we were effectively connected so
+	 * function drivers (e.g. RNDIS) can teardown network state cleanly
+	 * before hardware detach.
+	 */
 	if (udc->driver)
 		usb_gadget_disconnect(&udc->gadget);
 
 	usba_stop(udc);
 	phy_set_mode_ext(udc->phy, PHY_MODE_USB_DEVICE, 0);
+
 	usba_force_disconnect_pulse_locked(udc, mux_host);
+	dev_dbg(&udc->pdev->dev, "role-apply: none done\n");
 }
 
 static int usba_apply_role_device_locked(struct usba_udc *udc)
 {
-	int ret;
+	int ret = 0;
+	unsigned long flags;
 	bool mux_is_host = usba_get_mux_locked(udc);
 
+	/*
+	 * Same rationale as role=none: flush pending delayed suspend/wakeup bits
+	 * so the next worker run cannot apply an obsolete clock transition while
+	 * we explicitly move to role=device.
+	 */
+	spin_lock_irqsave(&udc->lock, flags);
+	udc->udc_irq_delayed_events = 0;
+	spin_unlock_irqrestore(&udc->lock, flags);
+
+	/* switch in all cases the mux in device mode */
 	usba_set_mux_locked(udc, false);
 
-	if (!udc->driver)
+	if (!udc->driver) {
+		dev_dbg(&udc->pdev->dev,
+			"role-device: deferred start (no gadget driver bound yet)\n");
 		return 0;
+	}
 
+	/* role=device is an explicit resume/start request */
 	udc->suspended = false;
 
 	phy_set_mode_ext(udc->phy, PHY_MODE_USB_DEVICE, 1);
 	ret = usba_start(udc);
 	if (ret) {
+		dev_err(&udc->pdev->dev,
+			"failed to start UDC in device mode: %d\n", ret);
 		phy_set_mode_ext(udc->phy, PHY_MODE_USB_DEVICE, 0);
 		usba_set_mux_locked(udc, mux_is_host);
+		dev_err(&udc->pdev->dev, "role-device: failed\n");
 		return ret;
 	}
 
 	usb_gadget_connect(&udc->gadget);
 
-	return 0;
+	return ret;
 }
 
