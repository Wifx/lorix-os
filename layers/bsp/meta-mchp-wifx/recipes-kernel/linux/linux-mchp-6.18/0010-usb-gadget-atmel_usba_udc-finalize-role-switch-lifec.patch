 	status = usba_readl(udc, INT_STA) & (int_enb | USBA_HIGH_SPEED);
 	DBG(DBG_INT, "irq, status=%#08x\n", status);
 
+	if (unlikely(READ_ONCE(udc->shutting_down))) {
