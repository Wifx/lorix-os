 		toggle_bias(udc, 1);
-	} else if (events & BIT(USBA_IRQ_CLOCK_EVT_SUSPEND_BIT)) {
-		if (READ_ONCE(udc->suspended))
+	} else if (events & USBA_IRQ_CLOCK_EVT_SUSPEND) {
+		if (!READ_ONCE(udc->suspended))
