 config USB_ATMEL_USBA
 	tristate "Atmel USBA"
 	depends on ARCH_AT91
+	select USB_ROLE_SWITCH
 	help
 	  USBA is the integrated high-speed USB Device controller on some
 	  AT91SAM9 and AT91CAP9 processors from Atmel.
 
+	  When described with the Device Tree property "usb-role-switch",
+	  this driver can expose role-switch control for DRD glue/policy
