+                           MMModemMode   *preferred,
+                           GError       **error)
+{
+    const gchar *response;
+
+    response = mm_base_modem_at_command_finish (MM_BASE_MODEM (self), res, error);
+    if (!response)
+        return FALSE;
+
+    return mm_fibocom_mc610_parse_gtrat_read_response (response, self, allowed, preferred, error);
+}
