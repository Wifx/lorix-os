+#define MM_TYPE_BROADBAND_MODEM_FIBOCOM_MC610            (mm_broadband_modem_fibocom_mc610_get_type ())
+#define MM_BROADBAND_MODEM_FIBOCOM_MC610(obj)            (G_TYPE_CHECK_INSTANCE_CAST ((obj), MM_TYPE_BROADBAND_MODEM_FIBOCOM_MC610, MMBroadbandModemFibocomMc610))
