+/*****************************************************************************/
+/* List profiles (3GPP profile management interface) */
+
+typedef enum {
+    BEARER_FIBOCOM_AUTH_UNKNOWN   = -1,
+    BEARER_FIBOCOM_AUTH_NONE      =  0,
+    BEARER_FIBOCOM_AUTH_PAP       =  1,
+    BEARER_FIBOCOM_AUTH_CHAP      =  2,
+} BearerFibocomAuthType;
+
+static MMBearerAllowedAuth
+mm_auth_type_from_fibocom_auth_type (guint fibocom_auth)
+{
+    switch (fibocom_auth) {
+    case BEARER_FIBOCOM_AUTH_NONE:
+        return MM_BEARER_ALLOWED_AUTH_NONE;
+    case BEARER_FIBOCOM_AUTH_PAP:
+        return MM_BEARER_ALLOWED_AUTH_PAP;
+    case BEARER_FIBOCOM_AUTH_CHAP:
+        return MM_BEARER_ALLOWED_AUTH_CHAP;
+    default:
+        return MM_BEARER_ALLOWED_AUTH_UNKNOWN;
+    }
+}
+
+typedef struct {
+    GList *profiles;
+} ListProfilesContext;
+
+static void
+list_profiles_context_free (ListProfilesContext *ctx)
+{
+    mm_3gpp_profile_list_free (ctx->profiles);
+    g_slice_free (ListProfilesContext, ctx);
+}
+
+typedef struct {
+    gint                 profile_id;
+    MMBearerAllowedAuth  allowed_auth;
+    gchar               *user;
+    gchar               *password;
+} ProfileAuth;
+
+static void
+profiles_auth_free (ProfileAuth *auth)
+{
+    if (auth->user)
+        g_free (auth->user);
+    if (auth->password)
+        g_free (auth->password);
+    g_slice_free (ProfileAuth, auth);
+}
+
+static void
+profiles_auth_list_free (GList *list)
+{
+    g_list_free_full (list, (GDestroyNotify) profiles_auth_free);
+}
+
+static gint
+profiles_auth_cmp (ProfileAuth *a,
+                   ProfileAuth *b)
+{
+    return (a->profile_id - b->profile_id);
+}
+
+static gboolean
+modem_3gpp_profile_manager_list_profiles_finish (MMIfaceModem3gppProfileManager  *self,
+                                                 GAsyncResult                    *res,
+                                                 GList                          **out_profiles,
+                                                 GError                         **error)
+{
+    ListProfilesContext *ctx;
+
+    if (!g_task_propagate_boolean (G_TASK (res), error))
+        return FALSE;
+
+    ctx = g_task_get_task_data (G_TASK (res));
+    if (out_profiles)
+        *out_profiles = g_steal_pointer (&ctx->profiles);
+    return TRUE;
+}
+
+static GList *
+mm_fibocom_parse_cgauth_read_response(const gchar *reply,
+                                      GError **error)
+{
+    GError                *inner_error = NULL;
+    g_autoptr(GRegex)      r = NULL;
+    g_autoptr(GMatchInfo)  match_info = NULL;
+    GList                 *list = NULL;
+
+    if (!reply || !reply[0])
+        /* No APNs authentication configured, all done */
+        return NULL;
+
+    r = g_regex_new ("\\+CGAUTH:\\s*(\\d+),(\\d+),\"([^\"]*)\",\"([^\"]*)\"",
+        G_REGEX_DOLLAR_ENDONLY | G_REGEX_RAW,
+        0, NULL);
+    g_assert (r);
+
+    g_regex_match_full (r, reply, strlen (reply), 0, 0, &match_info, &inner_error);
+    while (!inner_error && g_match_info_matches (match_info)) {
+        guint mgauth_cid = 0;
+        guint auth_type = 0;
+
+        if (mm_get_uint_from_match_info (match_info, 1, &mgauth_cid) &&
+            mm_get_uint_from_match_info (match_info, 2, &auth_type)) {
+            ProfileAuth *auth = g_slice_new0 (ProfileAuth);
+            // retrieve the profile and authentication type
+            auth->profile_id = mgauth_cid;
+            auth->allowed_auth = mm_auth_type_from_fibocom_auth_type (auth_type);
+            // retrieve the username and password
+            auth->user = mm_get_string_unquoted_from_match_info (match_info, 3);
+            auth->password = mm_get_string_unquoted_from_match_info (match_info, 4);
+
+            list = g_list_prepend (list, auth);
+        } else {
+            inner_error = g_error_new (MM_CORE_ERROR,
+                MM_CORE_ERROR_FAILED,
+                "Failed to parse +MGAUTH response");
+            break;
+        }
+
+        g_match_info_next (match_info, &inner_error);
+    }
+
+    if (inner_error) {
+        profiles_auth_list_free (list);
+        g_propagate_error (error, inner_error);
+        g_prefix_error (error, "Couldn't properly parse list of PDP contexts authentication. ");
+        return NULL;
+    }
+
+    return g_list_sort (list, (GCompareFunc)profiles_auth_cmp);
+}
+
+static void
+profile_manager_cgauth_ready (MMBaseModem  *self,
+                              GAsyncResult *res,
+                              GTask        *task)
+{
+    const gchar                  *response;
+    ListProfilesContext          *ctx;
+    GError                       *error = NULL;
+    GList                        *l;
+    GList                        *auth_list = NULL;
+
+    ctx = g_task_get_task_data (task);
+
+    response = mm_base_modem_at_command_finish (self, res, &error);
+    if (!response) {
+        mm_obj_dbg (self, "couldn't load auth settings: %s", error->message);
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    auth_list = mm_fibocom_parse_cgauth_read_response (response, &error);
+    if (error) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    // time to merge authentication info into existing profiles
+    if (ctx->profiles) {
+        for (l = ctx->profiles; l; l = l->next) {
+            MM3gppProfile *profile = MM_3GPP_PROFILE (l->data);
+            ProfileAuth search;
+            GList *auth = NULL;
+
+            search.profile_id = mm_3gpp_profile_get_profile_id (profile);
+            auth = g_list_find_custom (auth_list, &search, (GCompareFunc) profiles_auth_cmp);
+            if (auth) {
+                ProfileAuth *auth_data = auth->data;
+                mm_3gpp_profile_set_allowed_auth (profile, auth_data->allowed_auth);
+                if (auth_data->user) {
+                    mm_3gpp_profile_set_user (profile, auth_data->user);
+                }
+                if (auth_data->password) {
+                    mm_3gpp_profile_set_password (profile, auth_data->password);
+                }
+            }
+        }
+    }
+
+    profiles_auth_list_free (auth_list);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+profile_manager_parent_list_profiles_ready (MMIfaceModem3gppProfileManager *self,
+                                            GAsyncResult                   *res,
+                                            GTask                          *task)
+{
+    ListProfilesContext          *ctx;
+    GError                       *error = NULL;
+    MMBroadbandModemFibocomMc610 *fibocom = MM_BROADBAND_MODEM_FIBOCOM_MC610 (self);
+    GList                        *l;
+    MM3gppProfile                *found = NULL;
+
+    ctx = g_slice_new0 (ListProfilesContext);
+    g_task_set_task_data (task, ctx, (GDestroyNotify) list_profiles_context_free);
+
+    // we retrieve profiles detected from parent implementation
+    if (!iface_modem_3gpp_profile_manager_parent->list_profiles_finish (self, res, &ctx->profiles, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    // look if profile0 is included in the list of profiles
+    if (ctx->profiles) {
+        for (l = ctx->profiles; l; l = l->next) {
+            MM3gppProfile *profile = MM_3GPP_PROFILE (l->data);
+            if (0 == mm_3gpp_profile_get_profile_id (profile)) {
+                found = profile;
+                break;
+            }
+        }
+    }
+
+    if (found) {
+        // profile 0 found in modem, update local storage
+        mm_obj_dbg (self, "profile 0 fetched from modem");
+        if (fibocom->priv->profile0) {
+            g_object_unref (fibocom->priv->profile0);
+        }
+        fibocom->priv->profile0 = g_object_ref (found);
+    } else {
+        // profil 0 doesn't exist in modem, check if we have it locally
+        if (fibocom->priv->profile0) {
+            mm_obj_dbg (self, "profile 0 fetched from local store");
+            // add this profile to profiles list
+            ctx->profiles = g_list_prepend (ctx->profiles, g_object_ref (fibocom->priv->profile0));
+        } else {
+            // profile 0 not found in modem or local store, create a minimal profile 0
+            mm_obj_dbg (self, "profile 0 not found in modem or local store, creating minimal profile 0");
+            fibocom->priv->profile0 = mm_3gpp_profile_new ();
+            mm_3gpp_profile_set_profile_id (fibocom->priv->profile0, 0);
+            // add this profile to profiles list
+            ctx->profiles = g_list_prepend (ctx->profiles, g_object_ref (fibocom->priv->profile0));
+        }
+    }
+
+    mm_base_modem_at_command (
+        MM_BASE_MODEM (self),
+        "+CGAUTH?",
+        3,
+        FALSE,
+        (GAsyncReadyCallback)profile_manager_cgauth_ready,
+        task);
+}
+
+static void
+modem_3gpp_profile_manager_list_profiles (MMIfaceModem3gppProfileManager *self,
+                                          GAsyncReadyCallback             callback,
+                                          gpointer                        user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+
+    iface_modem_3gpp_profile_manager_parent->list_profiles (
+        self,
+        (GAsyncReadyCallback)profile_manager_parent_list_profiles_ready,
+        task);
+}
