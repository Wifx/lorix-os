From 5c69eb97061aa60ce1366baa6488114880d2bce2 Mon Sep 17 00:00:00 2001
From: Yannick Lanz <yannick.lanz@wifx.net>
Date: Fri, 28 Mar 2025 15:05:18 +0100
Subject: [PATCH 8/8] fibocom: start in flight mode to avoid network
 registration during init

Signed-off-by: Yannick Lanz <yannick.lanz@wifx.net>
---
 .../fibocom/mm-broadband-modem-fibocom.c      | 33 +++++++++++++++----
 1 file changed, 27 insertions(+), 6 deletions(-)

diff --git a/src/plugins/fibocom/mm-broadband-modem-fibocom.c b/src/plugins/fibocom/mm-broadband-modem-fibocom.c
index 4b5e393b..2c8403ee 100644
--- a/src/plugins/fibocom/mm-broadband-modem-fibocom.c
+++ b/src/plugins/fibocom/mm-broadband-modem-fibocom.c
@@ -248,7 +248,7 @@ modem_after_sim_unlock_finish (MMIfaceModem *self,
 }
 
 static void
-tpin_try_ready (MMBaseModem *self,
+cpin_try_ready (MMBaseModem *self,
                 GAsyncResult *res,
                 GTask *task)
 {
@@ -267,13 +267,13 @@ modem_after_sim_unlock (MMIfaceModem *self,
 
     /* Fibocom MC610 can be very long after SIM is enabled as it proceed
      * directly with network attachement if SIM allow it (most cases).
-     * +TPIN? is a know command which will wait on network attachement.
+     * +CPIN? is a know command which will wait on network attachement.
      */
     mm_base_modem_at_command (MM_BASE_MODEM (self),
-                              "+TPIN?",
+                              "+CPIN?",
                               30,
                               FALSE,
-                              (GAsyncReadyCallback)tpin_try_ready,
+                              (GAsyncReadyCallback)cpin_try_ready,
                               task);
 }
 
@@ -491,7 +491,7 @@ static gboolean
 fibocom_sim_wait_ready (MMBaseModem *self)
 {
     mm_base_modem_at_command (self,
-                              "+TPIN?",
+                              "+CPIN?",
                               30,
                               FALSE,
                               (GAsyncReadyCallback) fibocom_sim_test_ready,
@@ -1034,6 +1034,22 @@ modem_3gpp_profile_manager_deactivate_profile (MMIfaceModem3gppProfileManager *_
 
 /*****************************************************************************/
 
+static const gchar *primary_init_sequence[] = {
+    /* Ensure echo is off */
+    "E0",
+    /* Get word responses */
+    "V1",
+    /* Extended numeric codes */
+    "+CMEE=1",
+    /* Report all call status */
+    "X4",
+    /* Assert DCD when carrier detected */
+    "&C1",
+    /* Disable radio to avoid network automatic registration during init */
+    "+CFUN=4",
+    NULL
+};
+
 static void
 setup_ports (MMBroadbandModem *_self)
 {
@@ -1044,9 +1060,14 @@ setup_ports (MMBroadbandModem *_self)
     /* Call parent's setup ports first always */
     MM_BROADBAND_MODEM_CLASS (mm_broadband_modem_fibocom_parent_class)->setup_ports (_self);
 
-    ports[0] = mm_base_modem_peek_port_primary   (MM_BASE_MODEM (self));
+    ports[0] = mm_base_modem_peek_port_primary (MM_BASE_MODEM (self));
     ports[1] = mm_base_modem_peek_port_secondary (MM_BASE_MODEM (self));
 
+    if (ports[0])
+        g_object_set (ports[0],
+                      MM_PORT_SERIAL_AT_INIT_SEQUENCE, primary_init_sequence,
+                      NULL);
+
     for (i = 0; i < G_N_ELEMENTS (ports); i++) {
         if (!ports[i])
             continue;
-- 
2.34.1

