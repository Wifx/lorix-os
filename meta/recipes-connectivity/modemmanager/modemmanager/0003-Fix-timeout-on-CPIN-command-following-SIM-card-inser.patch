From 24076ce58a76a51512fda3143cff5ce62a5138e8 Mon Sep 17 00:00:00 2001
From: Yannick Serafini <yannick.serafini@wifx.net>
Date: Mon, 21 Oct 2024 13:14:33 +0200
Subject: [PATCH 3/4] Fix timeout on CPIN? command following SIM card
 insertion/remove

Signed-off-by: Yannick Lanz <yannick.lanz@wifx.net>
---
 src/mm-broadband-modem.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/mm-broadband-modem.c b/src/mm-broadband-modem.c
index 10a67ea3..384d94a4 100644
--- a/src/mm-broadband-modem.c
+++ b/src/mm-broadband-modem.c
@@ -763,7 +763,7 @@ parse_caps_cgmm (MMBaseModem   *self,
 static const MMBaseModemAtCommand capabilities[] = {
     { "+GCAP",  2, TRUE,  parse_caps_gcap },
     { "I",      1, TRUE,  parse_caps_gcap }, /* yes, really parse as +GCAP */
-    { "+CPIN?", 1, FALSE, parse_caps_cpin },
+    { "+CPIN?", 5, FALSE, parse_caps_cpin },
     { "+CGMM",  1, TRUE,  parse_caps_cgmm },
     { NULL }
 };
