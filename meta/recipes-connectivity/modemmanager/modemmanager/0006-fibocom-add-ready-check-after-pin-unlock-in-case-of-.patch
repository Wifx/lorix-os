From 6090073967d5b9aeffee81c9b6f55f263a5980b5 Mon Sep 17 00:00:00 2001
From: Yannick Lanz <yannick.lanz@wifx.net>
Date: Wed, 26 Mar 2025 16:21:23 +0100
Subject: [PATCH 6/6] fibocom: add ready check after pin unlock in case of
 automatic network attachement

Signed-off-by: Yannick Lanz <yannick.lanz@wifx.net>
---
 .../fibocom/mm-broadband-modem-fibocom.c      | 43 +++++++++++++++++++
 1 file changed, 43 insertions(+)

diff --git a/src/plugins/fibocom/mm-broadband-modem-fibocom.c b/src/plugins/fibocom/mm-broadband-modem-fibocom.c
index 08a9fdc8..7a2a0055 100644
--- a/src/plugins/fibocom/mm-broadband-modem-fibocom.c
+++ b/src/plugins/fibocom/mm-broadband-modem-fibocom.c
@@ -231,6 +231,47 @@ modem_power_off (MMIfaceModem *self,
                               user_data);
 }
 
+ /*****************************************************************************/
+ /* After SIM unlock (Modem interface) */
+
+static gboolean
+modem_after_sim_unlock_finish (MMIfaceModem *self,
+                               GAsyncResult *res,
+                               GError **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+tpin_try_ready (MMBaseModem *self,
+                GAsyncResult *res,
+                GTask *task)
+{
+    /* Well, we're done */
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+modem_after_sim_unlock (MMIfaceModem *self,
+                        GAsyncReadyCallback callback,
+                        gpointer user_data)
+{
+     GTask *task;
+    task = g_task_new (self, NULL, callback, user_data);
+
+    /* Fibocom MC610 can be very long after SIM is enabled as it proceed
+     * directly with network attachement if SIM allow it (most cases).
+     * +TPIN? is a know command which will wait on network attachement.
+     */
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                              "+TPIN?",
+                              30,
+                              FALSE,
+                              (GAsyncReadyCallback)tpin_try_ready,
+                              task);
+}
+
 /*****************************************************************************/
 /* Load supported modes (Modem interface) */
 
@@ -1021,6 +1062,8 @@ iface_modem_init (MMIfaceModem *iface)
     iface->modem_power_down_finish = modem_common_power_finish;
     iface->modem_power_off = modem_power_off;
     iface->modem_power_off_finish = modem_common_power_finish;
+    iface->modem_after_sim_unlock = modem_after_sim_unlock;
+    iface->modem_after_sim_unlock_finish = modem_after_sim_unlock_finish;
     iface->load_supported_modes = load_supported_modes;
     iface->load_supported_modes_finish = load_supported_modes_finish;
     iface->load_current_modes = load_current_modes;
-- 
