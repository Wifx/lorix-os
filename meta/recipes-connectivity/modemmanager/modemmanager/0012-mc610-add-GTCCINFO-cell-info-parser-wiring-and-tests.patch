+#include <glib.h>
+#include <glib-object.h>
+#include <locale.h>
+
+#include <ModemManager.h>
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-log-test.h"
+#include "mm-modem-helpers.h"
+#include "mm-modem-helpers-fibocom-mc610.h"
+
+/*****************************************************************************/
+/* Test +GTCCINFO? responses */
+
+static void
+test_gtccinfo_lte_serving_only (void)
+{
+    /* As captured on a MC610-EU, firmware 16000.1000.00.98.91.04 */
+    static const gchar *response =
+        "+GTCCINFO:\r\n"
+        "LTE service cell:\r\n"
+        "1,4,228,02,A546,510E06,1838,198,20,50,58,59,59,20\r\n"
+        "\r\n"
+        "LTE neighbor cell:\r\n";
+
+    g_autoptr(GError)  error = NULL;
+    GList             *list;
+    MMCellInfoLte     *cell;
+
+    list = mm_fibocom_mc610_parse_gtccinfo_response (response, NULL, &error);
+    g_assert_no_error (error);
+    g_assert (list);
+    g_assert_cmpuint (g_list_length (list), ==, 1);
+
+    g_assert (MM_IS_CELL_INFO_LTE (list->data));
+    cell = MM_CELL_INFO_LTE (list->data);
+
+    g_assert (mm_cell_info_get_serving (MM_CELL_INFO (cell)));
+    g_assert_cmpstr (mm_cell_info_lte_get_operator_id (cell), ==, "22802");
+    g_assert_cmpstr (mm_cell_info_lte_get_tac (cell), ==, "A546");
+    g_assert_cmpstr (mm_cell_info_lte_get_ci (cell), ==, "510E06");
+    /* 0x1838 = 6200, E-UTRA band 20, consistent with the <band> field */
+    g_assert_cmpuint (mm_cell_info_lte_get_earfcn (cell), ==, 6200);
+    g_assert_cmpstr (mm_cell_info_lte_get_physical_ci (cell), ==, "198");
+    /* <rsrp> 59 -> -141 + 59 = -82 dBm */
+    g_assert_cmpfloat (mm_cell_info_lte_get_rsrp (cell), ==, -82.0);
+    /* <rsrq> 20 -> -20 + 20 * 0.5 = -10 dB */
+    g_assert_cmpfloat (mm_cell_info_lte_get_rsrq (cell), ==, -10.0);
+
+    g_list_free_full (list, g_object_unref);
+}
+
+static void
+test_gtccinfo_lte_serving_and_neighbors (void)
+{
+    /* Example taken from the Fibocom AT Commands User Manual V3.0, section 9.12 */
+    static const gchar *response =
+        "+GTCCINFO:\r\n"
+        "LTE service cell:\r\n"
+        "1,4,460,11,770E,77CF205,64,B9,101,100,-10,35,35,4\r\n"
+        "\r\n"
+        "LTE neighbor cell:\r\n"
+        "2,4,,,,,64,1A1,,32,32,0\r\n"
+        "2,4,,,,,64,1A5,,30,30,2\r\n";
+
+    g_autoptr(GError)  error = NULL;
+    GList             *list;
+    MMCellInfoLte     *cell;
+
+    list = mm_fibocom_mc610_parse_gtccinfo_response (response, NULL, &error);
+    g_assert_no_error (error);
+    g_assert_cmpuint (g_list_length (list), ==, 3);
+
+    cell = MM_CELL_INFO_LTE (g_list_nth_data (list, 0));
+    g_assert (mm_cell_info_get_serving (MM_CELL_INFO (cell)));
+    g_assert_cmpstr (mm_cell_info_lte_get_operator_id (cell), ==, "46011");
+    g_assert_cmpstr (mm_cell_info_lte_get_tac (cell), ==, "770E");
+    g_assert_cmpstr (mm_cell_info_lte_get_ci (cell), ==, "77CF205");
+    g_assert_cmpuint (mm_cell_info_lte_get_earfcn (cell), ==, 100);
+    g_assert_cmpstr (mm_cell_info_lte_get_physical_ci (cell), ==, "B9");
+
+    /* Neighbor cells have most identity fields empty */
+    cell = MM_CELL_INFO_LTE (g_list_nth_data (list, 1));
+    g_assert (!mm_cell_info_get_serving (MM_CELL_INFO (cell)));
+    g_assert (!mm_cell_info_lte_get_operator_id (cell));
+    g_assert (!mm_cell_info_lte_get_tac (cell));
+    g_assert (!mm_cell_info_lte_get_ci (cell));
+    g_assert_cmpuint (mm_cell_info_lte_get_earfcn (cell), ==, 100);
+    g_assert_cmpstr (mm_cell_info_lte_get_physical_ci (cell), ==, "1A1");
+    /* <rsrp> 32 -> -109 dBm, <rsrq> 0 -> unknown */
+    g_assert_cmpfloat (mm_cell_info_lte_get_rsrp (cell), ==, -109.0);
+
+    cell = MM_CELL_INFO_LTE (g_list_nth_data (list, 2));
+    g_assert (!mm_cell_info_get_serving (MM_CELL_INFO (cell)));
+    g_assert_cmpstr (mm_cell_info_lte_get_physical_ci (cell), ==, "1A5");
+    g_assert_cmpfloat (mm_cell_info_lte_get_rsrq (cell), ==, -19.0);
+
+    g_list_free_full (list, g_object_unref);
+}
+
+static void
+test_gtccinfo_gsm (void)
+{
+    /* Synthetic sample built from the field layout documented in the Fibocom AT
+     * Commands User Manual V3.0, section 9.12. Not validated against hardware:
+     * GSM reporting is documented as available only on projects supporting the
+     * GSM standard on the 8910DM platform. */
+    static const gchar *response =
+        "+GTCCINFO:\r\n"
+        "GSM service cell:\r\n"
+        "1,1,228,02,A546,510E,3E8,32,900,5,0,30,30,3,0,0,0,25,25,0,0,26,-84,0\r\n"
+        "\r\n"
+        "GSM neighbor cell:\r\n"
+        "2,1,228,02,A546,510F,3E9,33,28,28,0,0,20,-90\r\n";
+
+    g_autoptr(GError)  error = NULL;
+    GList             *list;
+    MMCellInfoGsm     *cell;
+
+    list = mm_fibocom_mc610_parse_gtccinfo_response (response, NULL, &error);
+    g_assert_no_error (error);
+    g_assert_cmpuint (g_list_length (list), ==, 2);
+
+    g_assert (MM_IS_CELL_INFO_GSM (list->data));
+    cell = MM_CELL_INFO_GSM (g_list_nth_data (list, 0));
+    g_assert (mm_cell_info_get_serving (MM_CELL_INFO (cell)));
+    g_assert_cmpstr (mm_cell_info_gsm_get_operator_id (cell), ==, "22802");
+    g_assert_cmpstr (mm_cell_info_gsm_get_lac (cell), ==, "A546");
+    g_assert_cmpstr (mm_cell_info_gsm_get_ci (cell), ==, "510E");
+    g_assert_cmpuint (mm_cell_info_gsm_get_arfcn (cell), ==, 1000);
+    g_assert_cmpstr (mm_cell_info_gsm_get_base_station_id (cell), ==, "32");
+    g_assert_cmpuint (mm_cell_info_gsm_get_rx_level (cell), ==, 26);
+
+    cell = MM_CELL_INFO_GSM (g_list_nth_data (list, 1));
+    g_assert (!mm_cell_info_get_serving (MM_CELL_INFO (cell)));
+    g_assert_cmpstr (mm_cell_info_gsm_get_ci (cell), ==, "510F");
+    g_assert_cmpuint (mm_cell_info_gsm_get_arfcn (cell), ==, 1001);
+    g_assert_cmpuint (mm_cell_info_gsm_get_rx_level (cell), ==, 20);
+
+    g_list_free_full (list, g_object_unref);
+}
+
+static void
+test_gtccinfo_leading_zeros (void)
+{
+    static const gchar *response =
+        "+GTCCINFO:\r\n"
+        "LTE service cell:\r\n"
+        "1,4,228,02,0A546,00510E06,1838,198,20,50,58,59,59,20\r\n";
+
+    g_autoptr(GError)  error = NULL;
+    GList             *list;
+    MMCellInfoLte     *cell;
+
+    list = mm_fibocom_mc610_parse_gtccinfo_response (response, NULL, &error);
+    g_assert_no_error (error);
+    g_assert_cmpuint (g_list_length (list), ==, 1);
+
+    cell = MM_CELL_INFO_LTE (list->data);
+    g_assert_cmpstr (mm_cell_info_lte_get_tac (cell), ==, "A546");
+    g_assert_cmpstr (mm_cell_info_lte_get_ci (cell), ==, "510E06");
+
+    g_list_free_full (list, g_object_unref);
+}
+
+static void
+test_gtccinfo_no_cell (void)
+{
+    static const gchar *response =
+        "+GTCCINFO:\r\n"
+        "LTE neighbor cell:\r\n";
+
+    g_autoptr(GError)  error = NULL;
+    GList             *list;
+
+    list = mm_fibocom_mc610_parse_gtccinfo_response (response, NULL, &error);
+    g_assert (!list);
+    g_assert_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED);
+}
+
+static void
+test_gtccinfo_empty_neighbor_placeholder (void)
+{
+    /* As returned by a MC610-EU after AT+GTCCINFO="neighbourcell",0 found
+     * nothing: an all-zeros entry with <rat> set to "invalid network" */
+    static const gchar *response =
+        "+GTCCINFO:\r\n"
+        "LTE service cell:\r\n"
+        "1,4,228,02,A546,510E06,1838,198,20,50,59,61,61,20\r\n"
+        "\r\n"
+        "LTE neighbor cell:\r\n"
+        "0,0,0,0,0,0,0,0,0\r\n";
+
+    g_autoptr(GError)  error = NULL;
+    GList             *list;
+    MMCellInfoLte     *cell;
+
+    list = mm_fibocom_mc610_parse_gtccinfo_response (response, NULL, &error);
+    g_assert_no_error (error);
+    g_assert_cmpuint (g_list_length (list), ==, 1);
+
+    cell = MM_CELL_INFO_LTE (list->data);
+    g_assert (mm_cell_info_get_serving (MM_CELL_INFO (cell)));
+    g_assert_cmpstr (mm_cell_info_lte_get_ci (cell), ==, "510E06");
+    /* <rsrp> 61 -> -80 dBm */
+    g_assert_cmpfloat (mm_cell_info_lte_get_rsrp (cell), ==, -80.0);
+
+    g_list_free_full (list, g_object_unref);
+}
+
+static void
+test_gtccinfo_short_line (void)
+{
+    static const gchar *response =
+        "+GTCCINFO:\r\n"
+        "LTE service cell:\r\n"
+        "1,4,228,02\r\n";
+
+    g_autoptr(GError)  error = NULL;
+    GList             *list;
+
+    list = mm_fibocom_mc610_parse_gtccinfo_response (response, NULL, &error);
+    g_assert (!list);
+    g_assert_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED);
+}
+
+/*****************************************************************************/
+
+int main (int argc, char **argv)
+{
+    setlocale (LC_ALL, "");
+
+    g_test_init (&argc, &argv, NULL);
+
+    g_test_add_func ("/MM/fibocom-mc610/gtccinfo/lte-serving-only", test_gtccinfo_lte_serving_only);
+    g_test_add_func ("/MM/fibocom-mc610/gtccinfo/lte-serving-and-neighbors", test_gtccinfo_lte_serving_and_neighbors);
+    g_test_add_func ("/MM/fibocom-mc610/gtccinfo/gsm", test_gtccinfo_gsm);
+    g_test_add_func ("/MM/fibocom-mc610/gtccinfo/leading-zeros", test_gtccinfo_leading_zeros);
+    g_test_add_func ("/MM/fibocom-mc610/gtccinfo/no-cell", test_gtccinfo_no_cell);
+    g_test_add_func ("/MM/fibocom-mc610/gtccinfo/empty-neighbor-placeholder", test_gtccinfo_empty_neighbor_placeholder);
+    g_test_add_func ("/MM/fibocom-mc610/gtccinfo/short-line", test_gtccinfo_short_line);
+
+    return g_test_run ();
+}
