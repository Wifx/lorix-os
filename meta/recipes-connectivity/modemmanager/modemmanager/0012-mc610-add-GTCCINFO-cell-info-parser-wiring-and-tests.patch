+
+/*****************************************************************************/
+/* +GTCCINFO? response parser */
+
+/* Field layouts of the +GTCCINFO? (read command) reply, as documented in the
+ * "Fibocom AT Commands User Manual V3.0", section 9.12.
+ *
+ * All the cell identifiers (lac/tac, cell id, arfcn/earfcn, bsic, physical cell
+ * id) are reported in *hexadecimal*, while mcc, mnc and all the measurement
+ * values are reported in decimal. This is confirmed by a live capture on
+ * firmware 16000.1000.00.98.91.04:
+ *
+ *   1,4,228,02,A546,510E06,1838,198,20,50,58,59,59,20
+ *                          ^tac ^ci  ^earfcn      ^band
+ *
+ * where tac/ci match the ones reported by +CEREG, and 0x1838 = 6200, which is
+ * indeed an E-UTRA band 20 EARFCN (6150..6449), consistent with the decimal
+ * "20" reported in the band field right after the physical cell id.
+ */
+
+/* <IsServiceCell>,<rat>,<mcc>,<mnc>,<lac>,<cell_id>,<arfcn>,<basic>,<band>,
+ * <txpwr>,<dtx_used>,<c1>,<c2>,<access_tech>,<amr_acs>,<maio>,<hsn>,<rxlevsub>,
+ * <rxlevfull>,<rxqualsub>,<rxqualfull>,<rxlev>,<rssi>,<ber_lev> */
+#define GTCCINFO_GSM_SERVING_N_FIELDS   24
+#define GTCCINFO_GSM_SERVING_RXLEV      21
+
+/* <IsServiceCell>,<rat>,<mcc>,<mnc>,<lac>,<cell_id>,<arfcn>,<basic>,<c1>,<c2>,
+ * <c31>,<c32>,<rxlev>,<rssi> */
+#define GTCCINFO_GSM_NEIGHBOR_N_FIELDS  14
+#define GTCCINFO_GSM_NEIGHBOR_RXLEV     12
+
+/* <IsServiceCell>,<rat>,<mcc>,<mnc>,<tac>,<cell_id>,<earfcn>,<physical_cellId>,
+ * <band>,<bandwidth>,<rssnr_value>,<rxlev>,<rsrp>,<rsrq> */
+#define GTCCINFO_LTE_SERVING_N_FIELDS   14
+#define GTCCINFO_LTE_SERVING_RSRP       12
+#define GTCCINFO_LTE_SERVING_RSRQ       13
+
+/* <IsServiceCell>,<rat>,<mcc>,<mnc>,<tac>,<cell_id>,<earfcn>,<physical_cellId>,
+ * <bandwidth>,<rxlev>,<rsrp>,<rsrq> */
+#define GTCCINFO_LTE_NEIGHBOR_N_FIELDS  12
+#define GTCCINFO_LTE_NEIGHBOR_RSRP      10
+#define GTCCINFO_LTE_NEIGHBOR_RSRQ      11
+
+/* Fields common to every layout */
+enum {
+    GTCCINFO_FIELD_IS_SERVICE_CELL = 0,
+    GTCCINFO_FIELD_RAT             = 1,
+    GTCCINFO_FIELD_MCC             = 2,
+    GTCCINFO_FIELD_MNC             = 3,
+    GTCCINFO_FIELD_LAC_TAC         = 4,
+    GTCCINFO_FIELD_CELL_ID         = 5,
+    GTCCINFO_FIELD_ARFCN_EARFCN    = 6,
+    GTCCINFO_FIELD_BSIC_PCI        = 7,
+    GTCCINFO_N_FIELDS_COMMON       = 8,
+};
+
+/* <IsServiceCell> */
+#define GTCCINFO_IS_SERVICE_CELL    1
+
+/* <rat> */
+#define GTCCINFO_RAT_INVALID        0
+#define GTCCINFO_RAT_GSM            1
+#define GTCCINFO_RAT_LTE            4
+
+typedef enum {
+    GTCCINFO_SECTION_UNKNOWN,
+    GTCCINFO_SECTION_GSM_SERVING,
+    GTCCINFO_SECTION_GSM_NEIGHBOR,
+    GTCCINFO_SECTION_LTE_SERVING,
+    GTCCINFO_SECTION_LTE_NEIGHBOR,
+} GtccinfoSection;
+
+/* Neighbor cell entries may leave fields empty, e.g. "2,4,,,,,64,1A1,,32,32,0" */
+static const gchar *
+gtccinfo_field (GStrv split,
+                guint index)
+{
+    const gchar *field;
+
+    if (index >= g_strv_length (split))
+        return NULL;
+    field = split[index];
+    return (field && field[0]) ? field : NULL;
+}
+
+/* The MMCellInfo identifiers are all defined as upper-case hex strings without
+ * leading zeros, which is exactly what the module reports already, but we
+ * normalize anyway to get rid of any leading zero. */
+static gchar *
+gtccinfo_hex_id_to_string (GStrv  split,
+                           guint  index)
+{
+    const gchar *field;
+    guint        value;
+
+    field = gtccinfo_field (split, index);
+    if (!field || !mm_get_uint_from_hex_str (field, &value))
+        return NULL;
+    return g_strdup_printf ("%X", value);
+}
+
+static gboolean
+gtccinfo_hex_uint (GStrv   split,
+                   guint   index,
+                   guint  *out)
+{
+    const gchar *field;
+
+    field = gtccinfo_field (split, index);
+    return field && mm_get_uint_from_hex_str (field, out);
+}
+
+static gboolean
+gtccinfo_dec_uint (GStrv   split,
+                   guint   index,
+                   guint  *out)
+{
+    const gchar *field;
+
+    field = gtccinfo_field (split, index);
+    return field && mm_get_uint_from_str (field, out);
+}
+
+static gchar *
+gtccinfo_operator_id (GStrv split)
+{
+    const gchar *mcc;
+    const gchar *mnc;
+
+    mcc = gtccinfo_field (split, GTCCINFO_FIELD_MCC);
+    mnc = gtccinfo_field (split, GTCCINFO_FIELD_MNC);
+    if (!mcc || !mnc)
+        return NULL;
+    /* Both are decimal and already zero-padded by the module (e.g. "228","02") */
+    return g_strdup_printf ("%s%s", mcc, mnc);
+}
+
+/* <rsrp> and <rxlev>: 0 means "less than -140 dBm or undetectable",
+ * n in [1,97] means -141 + n dBm. */
+static gboolean
+gtccinfo_rsrp_to_dbm (GStrv     split,
+                      guint     index,
+                      gdouble  *out)
+{
+    guint value;
+
+    if (!gtccinfo_dec_uint (split, index, &value) || value == 0 || value > 97)
+        return FALSE;
+    *out = -141.0 + (gdouble) value;
+    return TRUE;
+}
+
+/* <rsrq>: 0 means "less than -19.5 dB", n in [1,34] means -20 + n*0.5 dB. */
+static gboolean
+gtccinfo_rsrq_to_db (GStrv     split,
+                     guint     index,
+                     gdouble  *out)
+{
+    guint value;
+
+    if (!gtccinfo_dec_uint (split, index, &value) || value == 0 || value > 34)
+        return FALSE;
+    *out = -20.0 + ((gdouble) value * 0.5);
+    return TRUE;
+}
+
+static MMCellInfo *
+gtccinfo_parse_lte_cell (GStrv     split,
+                         gboolean  serving,
+                         gpointer  log_object)
+{
+    g_autoptr(MMCellInfoLte)  cell = NULL;
+    g_autofree gchar         *operator_id = NULL;
+    g_autofree gchar         *tac = NULL;
+    g_autofree gchar         *ci = NULL;
+    g_autofree gchar         *pci = NULL;
+    guint                     rsrp_index;
+    guint                     rsrq_index;
+    guint                     value;
+    gdouble                   dvalue;
+
+    cell = MM_CELL_INFO_LTE (mm_cell_info_lte_new_from_dictionary (NULL));
+    mm_cell_info_set_serving (MM_CELL_INFO (cell), serving);
+
+    if ((operator_id = gtccinfo_operator_id (split)))
+        mm_cell_info_lte_set_operator_id (cell, operator_id);
+    if ((tac = gtccinfo_hex_id_to_string (split, GTCCINFO_FIELD_LAC_TAC)))
+        mm_cell_info_lte_set_tac (cell, tac);
+    if ((ci = gtccinfo_hex_id_to_string (split, GTCCINFO_FIELD_CELL_ID)))
+        mm_cell_info_lte_set_ci (cell, ci);
+    if ((pci = gtccinfo_hex_id_to_string (split, GTCCINFO_FIELD_BSIC_PCI)))
+        mm_cell_info_lte_set_physical_ci (cell, pci);
+    if (gtccinfo_hex_uint (split, GTCCINFO_FIELD_ARFCN_EARFCN, &value))
+        mm_cell_info_lte_set_earfcn (cell, value);
+
+    if (serving) {
+        rsrp_index = GTCCINFO_LTE_SERVING_RSRP;
+        rsrq_index = GTCCINFO_LTE_SERVING_RSRQ;
+    } else {
+        rsrp_index = GTCCINFO_LTE_NEIGHBOR_RSRP;
+        rsrq_index = GTCCINFO_LTE_NEIGHBOR_RSRQ;
+    }
+
+    if (gtccinfo_rsrp_to_dbm (split, rsrp_index, &dvalue))
+        mm_cell_info_lte_set_rsrp (cell, dvalue);
+    if (gtccinfo_rsrq_to_db (split, rsrq_index, &dvalue))
+        mm_cell_info_lte_set_rsrq (cell, dvalue);
+
+    /* <band>, <bandwidth> and <rssnr_value> have no matching property in
+     * MMCellInfoLte, so they are dropped. */
+
+    mm_obj_dbg (log_object, "+GTCCINFO: parsed LTE %s cell", serving ? "serving" : "neighbor");
+    return MM_CELL_INFO (g_steal_pointer (&cell));
+}
+
+static MMCellInfo *
+gtccinfo_parse_gsm_cell (GStrv     split,
+                         gboolean  serving,
+                         gpointer  log_object)
+{
+    g_autoptr(MMCellInfoGsm)  cell = NULL;
+    g_autofree gchar         *operator_id = NULL;
+    g_autofree gchar         *lac = NULL;
+    g_autofree gchar         *ci = NULL;
+    g_autofree gchar         *bsic = NULL;
+    guint                     value;
+
+    cell = MM_CELL_INFO_GSM (mm_cell_info_gsm_new_from_dictionary (NULL));
+    mm_cell_info_set_serving (MM_CELL_INFO (cell), serving);
+
+    if ((operator_id = gtccinfo_operator_id (split)))
+        mm_cell_info_gsm_set_operator_id (cell, operator_id);
+    if ((lac = gtccinfo_hex_id_to_string (split, GTCCINFO_FIELD_LAC_TAC)))
+        mm_cell_info_gsm_set_lac (cell, lac);
+    if ((ci = gtccinfo_hex_id_to_string (split, GTCCINFO_FIELD_CELL_ID)))
+        mm_cell_info_gsm_set_ci (cell, ci);
+    if ((bsic = gtccinfo_hex_id_to_string (split, GTCCINFO_FIELD_BSIC_PCI)))
+        mm_cell_info_gsm_set_base_station_id (cell, bsic);
+    if (gtccinfo_hex_uint (split, GTCCINFO_FIELD_ARFCN_EARFCN, &value))
+        mm_cell_info_gsm_set_arfcn (cell, value);
+
+    if (gtccinfo_dec_uint (split,
+                           serving ? GTCCINFO_GSM_SERVING_RXLEV : GTCCINFO_GSM_NEIGHBOR_RXLEV,
+                           &value))
+        mm_cell_info_gsm_set_rx_level (cell, value);
+
+    mm_obj_dbg (log_object, "+GTCCINFO: parsed GSM %s cell", serving ? "serving" : "neighbor");
+    return MM_CELL_INFO (g_steal_pointer (&cell));
+}
+
+static MMCellInfo *
+gtccinfo_parse_cell (const gchar      *line,
+                     GtccinfoSection   section,
+                     gpointer          log_object)
+{
+    g_auto(GStrv) split = NULL;
+    gboolean      serving;
+    guint         n_fields_expected;
+    guint         n_fields;
+    guint         value;
+
+    split = g_strsplit (line, ",", -1);
+    n_fields = g_strv_length (split);
+    if (n_fields < GTCCINFO_N_FIELDS_COMMON) {
+        mm_obj_warn (log_object, "unexpected number of fields in +GTCCINFO entry: %s", line);
+        return NULL;
+    }
+
+    /* An empty section is reported as an all-zeros placeholder entry, e.g.
+     * "0,0,0,0,0,0,0,0,0" */
+    if (!gtccinfo_dec_uint (split, GTCCINFO_FIELD_RAT, &value) || value == GTCCINFO_RAT_INVALID) {
+        mm_obj_dbg (log_object, "ignoring +GTCCINFO entry without a valid access technology: %s", line);
+        return NULL;
+    }
+
+    switch (section) {
+    case GTCCINFO_SECTION_GSM_SERVING:
+        serving = TRUE;
+        n_fields_expected = GTCCINFO_GSM_SERVING_N_FIELDS;
+        break;
+    case GTCCINFO_SECTION_GSM_NEIGHBOR:
+        serving = FALSE;
+        n_fields_expected = GTCCINFO_GSM_NEIGHBOR_N_FIELDS;
+        break;
+    case GTCCINFO_SECTION_LTE_SERVING:
+        serving = TRUE;
+        n_fields_expected = GTCCINFO_LTE_SERVING_N_FIELDS;
+        break;
+    case GTCCINFO_SECTION_LTE_NEIGHBOR:
+        serving = FALSE;
+        n_fields_expected = GTCCINFO_LTE_NEIGHBOR_N_FIELDS;
+        break;
+    case GTCCINFO_SECTION_UNKNOWN:
+    default:
+        g_assert_not_reached ();
+    }
+
+    /* The section header already tells us the layout, but <IsServiceCell> is
+     * authoritative; only warn when they disagree, the header wins since the
+     * field count depends on it. */
+    if (gtccinfo_dec_uint (split, GTCCINFO_FIELD_IS_SERVICE_CELL, &value) &&
+        ((value == GTCCINFO_IS_SERVICE_CELL) != serving))
+        mm_obj_dbg (log_object, "+GTCCINFO: <IsServiceCell> disagrees with section header: %s", line);
+
+    if (n_fields != n_fields_expected)
+        mm_obj_dbg (log_object, "+GTCCINFO: expected %u fields but got %u: %s",
+                    n_fields_expected, n_fields, line);
+
+    if (section == GTCCINFO_SECTION_GSM_SERVING || section == GTCCINFO_SECTION_GSM_NEIGHBOR)
+        return gtccinfo_parse_gsm_cell (split, serving, log_object);
+    return gtccinfo_parse_lte_cell (split, serving, log_object);
+}
+
+GList *
+mm_fibocom_mc610_parse_gtccinfo_response (const gchar  *response,
+                                          gpointer      log_object,
+                                          GError      **error)
+{
+    g_auto(GStrv)    lines = NULL;
+    GList           *list = NULL;
+    GtccinfoSection  section = GTCCINFO_SECTION_UNKNOWN;
+    guint            i;
+
+    /*
+     * E.g. while registered in LTE:
+     *  AT+GTCCINFO?
+     *  +GTCCINFO:
+     *  LTE service cell:
+     *  1,4,228,02,A546,510E06,1838,198,20,50,58,59,59,20
+     *
+     *  LTE neighbor cell:
+     *
+     * and while registered in GSM the sections are "GSM service cell:" and
+     * "GSM neighbor cell:" instead, with a different field layout.
+     */
+    lines = g_strsplit_set (response, "\r\n", -1);
+    for (i = 0; lines[i]; i++) {
+        const gchar *line;
+        MMCellInfo  *cell;
+
+        line = g_strstrip (lines[i]);
+        if (!line[0] || g_str_has_prefix (line, "+GTCCINFO"))
+            continue;
+
+        if (g_strrstr (line, "service cell") || g_strrstr (line, "neighbor cell")) {
+            gboolean is_serving_section;
+
+            is_serving_section = (g_strrstr (line, "service cell") != NULL);
+            if (g_strrstr (line, "LTE"))
+                section = is_serving_section ? GTCCINFO_SECTION_LTE_SERVING : GTCCINFO_SECTION_LTE_NEIGHBOR;
+            else if (g_strrstr (line, "GSM"))
+                section = is_serving_section ? GTCCINFO_SECTION_GSM_SERVING : GTCCINFO_SECTION_GSM_NEIGHBOR;
+            else
+                section = GTCCINFO_SECTION_UNKNOWN;
+            continue;
+        }
+
+        if (section == GTCCINFO_SECTION_UNKNOWN) {
+            mm_obj_dbg (log_object, "ignoring unhandled +GTCCINFO entry: %s", line);
+            continue;
+        }
+
+        cell = gtccinfo_parse_cell (line, section, log_object);
+        if (cell)
+            list = g_list_append (list, cell);
+    }
+
+    if (!list) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                     "No cell info found in +GTCCINFO? response");
+        return NULL;
+    }
+
+    return list;
+}
