+ */
+
+#include <glib.h>
+#include <string.h>
+
+#include "mm-log.h"
+#include "mm-modem-helpers.h"
+#include "mm-modem-helpers-fibocom-mc610.h"
+#include "mm-modem-helpers.h"
+#include "mm-common-helpers.h"
+
+/* Index of the array is the fibocom MC610 specific value */
+static const MMModemMode fibocom_mc610_combinations[] = {
+    (                     MM_MODEM_MODE_CS ),
+    ( MM_MODEM_MODE_NONE                                                        ),
+    ( MM_MODEM_MODE_NONE                                                        ),
+    (                                                          MM_MODEM_MODE_4G ),
+    ( MM_MODEM_MODE_NONE                                                        ),
+    (                    MM_MODEM_MODE_CS |                    MM_MODEM_MODE_4G ),
+    ( MM_MODEM_MODE_NONE                                                        ),
+    ( MM_MODEM_MODE_NONE                                                        ),
+    ( MM_MODEM_MODE_NONE                                                        ),
+    ( MM_MODEM_MODE_NONE                                                        ),
+    ( MM_MODEM_MODE_ANY ),
+};
+
+GArray *
+mm_fibocom_m610_parse_gtrat_test_response (const gchar  *response,
+                                      gpointer      log_object,
+                                      GError      **error)
+{
+    GArray *combinations = NULL;
+    GArray *selected = NULL;
+    GArray *preferred = NULL;
+    gchar **split;
+    guint   split_len;
+    GError *inner_error = NULL;
+    guint   i;
+
+    /*
+     * E.g.:
+     *  AT+GTRAT=?
+     *  +GTRAT: (0,3,5,10),(0,3),(0,3)
+     */
+    response = mm_strip_tag (response, "+GTRAT:");
+    split = mm_split_string_groups (response);
+    split_len = g_strv_length (split);
+    if (split_len != 3) {
+        inner_error = g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                   "Unexpected number of groups in +GTRAT=? response: %u", g_strv_length (split));
+        goto out;
+    }
+
+    /* The selected list must have values */
+    selected = mm_parse_uint_list (split[0], &inner_error);
+    if (inner_error)
+        goto out;
+
+    if (!selected) {
+        inner_error = g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                   "No selected RAT values given in +GTRAT=? response");
+        goto out;
+    }
+
+    /* For our purposes, the preferred list may be empty */
+    preferred = mm_parse_uint_list (split[1], &inner_error);
+    if (inner_error)
+        goto out;
+
+    /* Build array of combinations */
+    combinations = g_array_new (FALSE, FALSE, sizeof (MMModemModeCombination));
+
+    mm_obj_dbg (log_object, "gtrat test parse, selected len: %d", selected->len);
+    for (i = 0; i < selected->len; i++) {
+        guint                  selected_value;
+        MMModemModeCombination combination;
+        guint                  j;
+
+        selected_value = g_array_index (selected, guint, i);
+        if (selected_value >= G_N_ELEMENTS (fibocom_mc610_combinations)) {
+            mm_obj_warn (log_object, "unexpected AcT value: %u", selected_value);
+            continue;
+        }
+
+        /* Combination without any preferred */
+        combination.allowed = fibocom_mc610_combinations[selected_value];
+        combination.preferred = MM_MODEM_MODE_NONE;
+        if (mm_count_bits_set (combination.allowed) == 1) {
+            if (combination.allowed != MM_MODEM_MODE_ANY)
+                g_array_append_val (combinations, combination);
+
+            continue;
+        }
+
+        if (!preferred)
+            continue;
+
+        for (j = 0; j < preferred->len; j++) {
+            guint preferred_value;
+
+            preferred_value = g_array_index (preferred, guint, j);
+            if (preferred_value >= G_N_ELEMENTS (fibocom_mc610_combinations)) {
+                mm_obj_warn (log_object, "unexpected AcT preferred value: %u", preferred_value);
+                continue;
+            }
+            combination.preferred = fibocom_mc610_combinations[preferred_value];
+            if (mm_count_bits_set (combination.preferred) != 1) {
+                mm_obj_warn (log_object, "AcT preferred value should be a single AcT: %u", preferred_value);
+                continue;
+            }
+            if (!(combination.allowed & combination.preferred))
+                continue;
+            g_array_append_val (combinations, combination);
+        }
+    }
+
+    if (combinations->len == 0) {
+        inner_error = g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                   "No combinations built from +GTRAT=? response");
+        goto out;
+    }
+
+out:
+    g_strfreev (split);
+    if (selected)
+        g_array_unref (selected);
+    if (preferred)
+        g_array_unref (preferred);
+
+    if (inner_error) {
+        if (combinations)
+            g_array_unref (combinations);
+        g_propagate_error (error, inner_error);
+        return NULL;
+    }
+
+    return combinations;
+}
+
+gboolean
+mm_fibocom_m610_parse_gtrat_read_response (const gchar  *response,
+                                      gpointer      log_object,
+                                      MMModemMode  *out_allowed,
+                                      MMModemMode  *out_preferred,
+                                      GError      **error)
+{
+    g_autoptr(GRegex)      r = NULL;
+    g_autoptr(GMatchInfo)  match_info = NULL;
+    GError                *inner_error = NULL;
+    MMModemMode            allowed = MM_MODEM_MODE_NONE;
+    MMModemMode            preferred = MM_MODEM_MODE_NONE;
+    g_autofree gchar      *allowed_str = NULL;
+    g_autofree gchar      *preferred_str = NULL;
+
+    g_assert (out_allowed != NULL && out_preferred != NULL);
+
+    /* Response may be e.g.:
+     * +GTRAT: 10,3,0
+     */
+    r = g_regex_new ("\\+GTRAT: (\\d+)(?:,(\\d+))?(?:,(\\d+))?(?:\\r\\n)?", 0, 0, NULL);
+    g_assert (r != NULL);
+
+    g_regex_match_full (r, response, strlen (response), 0, 0, &match_info, &inner_error);
+    if (!inner_error && g_match_info_matches (match_info)) {
+        guint  value = 0;
+
+        /* Selected item is mandatory */
+        if (!mm_get_uint_from_match_info (match_info, 1, &value)) {
+            inner_error = g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                       "Couldn't read AcT selected value");
+            goto out;
+        }
+        mm_obj_dbg (log_object, "current mode: %d", value);
+        if (value >= G_N_ELEMENTS (fibocom_mc610_combinations)) {
+            inner_error = g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                       "Unexpected AcT selected value: %u", value);
+            goto out;
+        }
+        allowed = fibocom_mc610_combinations[value];
+        allowed_str = mm_modem_mode_build_string_from_mask (allowed);
+        mm_obj_dbg (log_object, "current allowed modes retrieved: %s", allowed_str);
+
+        /* If only one mode is allowed (not ANY or multiple), we ignore preferred value */
+        if (mm_count_bits_set (allowed) == 1) {
+            preferred = MM_MODEM_MODE_NONE;
+            goto out;
+        }
+
+        /* Preferred item is optional */
+        if (mm_get_uint_from_match_info (match_info, 2, &value)) {
+            if (value >= G_N_ELEMENTS (fibocom_mc610_combinations)) {
+                inner_error = g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                           "Unexpected AcT preferred value: %u", value);
+                goto out;
+            }
+
+            preferred = fibocom_mc610_combinations[value];
+            preferred_str = mm_modem_mode_build_string_from_mask (preferred);
+            mm_obj_dbg (log_object, "current preferred modes retrieved: %s", preferred_str);
+            if (mm_count_bits_set (preferred) != 1) {
+                inner_error = g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                           "AcT preferred value should be a single AcT: %s", preferred_str);
+                goto out;
+            }
+            if (!(allowed & preferred)) {
+                inner_error = g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                           "AcT preferred value (%s) not a subset of the allowed value (%s)",
+                                           preferred_str, allowed_str);
+                goto out;
+            }
+        }
+    }
+
+out:
+    if (inner_error) {
+        g_propagate_error (error, inner_error);
+        return FALSE;
+    }
+
+    if (allowed == MM_MODEM_MODE_NONE) {
+        inner_error = g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                   "Couldn't parse +GTRAT response: %s", response);
+        return FALSE;
+    }
+
+    *out_allowed = allowed;
+    *out_preferred = preferred;
+    return TRUE;
+}
+
+static gboolean
+append_gtrat_rat_value (GString      *str,
+                        MMModemMode   mode,
+                        GError      **error)
+{
+    guint i;
+
+    for (i = 0; i < G_N_ELEMENTS (fibocom_mc610_combinations); i++) {
+        if (fibocom_mc610_combinations[i] == mode) {
+            g_string_append_printf (str, "%u", i);
+            return TRUE;
+        }
+    }
+
+    g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                 "No AcT value matches requested mode");
+    return FALSE;
+}
+
+gchar *mm_fibocom_m610_build_gtrat_set_command (MMModemMode allowed,
+                                           MMModemMode preferred,
+                                           GError **error)
+{
+    GString *command;
+
+    command = g_string_new("+GTRAT=");
+    if (!append_gtrat_rat_value (command, allowed, error)) {
+        g_string_free (command, TRUE);
+        return NULL;
+    }
+
+    if (preferred != MM_MODEM_MODE_NONE) {
+        if (mm_count_bits_set (preferred) != 1) {
+            *error = g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                  "AcT preferred value should be a single AcT");
+            g_string_free (command, TRUE);
+            return NULL;
+        }
+        g_string_append (command, ",");
+        if (!append_gtrat_rat_value (command, preferred, error)) {
+            g_string_free (command, TRUE);
+            return NULL;
+        }
+    }
+
+    return g_string_free (command, FALSE);
+}
