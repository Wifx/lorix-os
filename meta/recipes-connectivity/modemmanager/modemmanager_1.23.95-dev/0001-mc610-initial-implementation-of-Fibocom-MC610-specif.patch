+#include <stdlib.h>
+#include <gmodule.h>
+
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-log-object.h"
+#include "mm-plugin-common.h"
+#include "mm-broadband-modem.h"
+#include "mm-broadband-modem-fibocom-mc610.h"
+
+#define MM_TYPE_PLUGIN_FIBOCOM_MC610 mm_plugin_fibocom_mc610_get_type ()
+MM_DEFINE_PLUGIN (FIBOCOM_MC610, fibocom_mc610, FibocomMc610)
+
+/*****************************************************************************/
+
+static MMBaseModem *
+create_modem (MMPlugin     *self,
+              const gchar  *uid,
+              const gchar  *physdev,
+              const gchar **drivers,
+              guint16       vendor,
+              guint16       product,
+              guint16       subsystem_vendor,
+              guint16       subsystem_device,
+              GList        *probes,
+              GError      **error)
+{
+    mm_obj_dbg (self, "Fibocom MC610 modem found...");
+    return MM_BASE_MODEM (mm_broadband_modem_fibocom_mc610_new (uid,
+                                                                physdev,
+                                                                drivers,
+                                                                mm_plugin_get_name (self),
+                                                                vendor,
+                                                                product));
+}
+
+/*****************************************************************************/
+
+MM_PLUGIN_NAMED_CREATOR_SCOPE MMPlugin *
+mm_plugin_create_fibocom_mc610 (void)
+{
+    static const gchar *subsystems[] = { "tty", "net", "usbmisc", NULL };
+    static const guint16 vendor_ids[] = { 0x1782, 0 };
+    static const guint16 product_ids[] = { 0x4d10, 0x4d11, 0 };
+
+    return MM_PLUGIN (
+        g_object_new (MM_TYPE_PLUGIN_FIBOCOM_MC610,
+                      MM_PLUGIN_NAME,                MM_MODULE_NAME,
+                      MM_PLUGIN_ALLOWED_SUBSYSTEMS,  subsystems,
+                      MM_PLUGIN_ALLOWED_VENDOR_IDS,  vendor_ids,
+                      MM_PLUGIN_ALLOWED_PRODUCT_IDS, product_ids,
+                      MM_PLUGIN_ALLOWED_AT,          TRUE,
+                      MM_PLUGIN_ALLOWED_MBIM,        FALSE,
+                      MM_PLUGIN_ALLOWED_QMI,         FALSE,
+                      MM_PLUGIN_XMM_PROBE,           FALSE,
+                      NULL));
+}
+
+static void
+mm_plugin_fibocom_mc610_init (MMPluginFibocomMc610 *self)
+{
+}
+
+static void
+mm_plugin_fibocom_mc610_class_init (MMPluginFibocomMc610Class *klass)
+{
+    MMPluginClass *plugin_class = MM_PLUGIN_CLASS (klass);
+
+    plugin_class->create_modem = create_modem;
+}
