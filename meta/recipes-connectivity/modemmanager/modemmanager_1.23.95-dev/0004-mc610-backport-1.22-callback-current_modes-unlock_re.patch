+/*****************************************************************************/
+/* After SIM unlock (Modem interface) */
+
+ static gboolean
+ modem_after_sim_unlock_finish (MMIfaceModem *self,
+                                GAsyncResult *res,
+                                GError **error)
+ {
+     return g_task_propagate_boolean (G_TASK (res), error);
+ }
+
+ static void
+ cpin_try_ready (MMBaseModem *self,
+                 GAsyncResult *res,
+                 GTask *task)
+ {
+     /* Well, we're done */
+     g_task_return_boolean (task, TRUE);
+     g_object_unref (task);
+ }
+
+ static void
+ modem_after_sim_unlock (MMIfaceModem *self,
+                         GAsyncReadyCallback callback,
+                         gpointer user_data)
+ {
+     GTask *task;
+     task = g_task_new (self, NULL, callback, user_data);
+
+     /* Fibocom MC610 can be very long after SIM is enabled as it proceed
+      * directly with network attachement if SIM allow it (most cases).
+      * +CPIN? is a know command which will wait on network attachement.
+      */
+     /* TODO: This is probably not the case anymore as we now are in flightmode
+       * during initialization. Test if this is still needed.
+       */
+     mm_base_modem_at_command (MM_BASE_MODEM (self),
+                               "+CPIN?",
+                               30,
+                               FALSE,
+                               (GAsyncReadyCallback)cpin_try_ready,
+                               task);
+ }
+
+ /*****************************************************************************/
+/* Load supported modes (Modem interface) */
+
+static GArray *
+load_supported_modes_finish (MMIfaceModem  *self,
+                             GAsyncResult  *res,
+                             GError       **error)
+{
+    const gchar *response;
+    GArray      *combinations;
+
+    response = mm_base_modem_at_command_finish (MM_BASE_MODEM (self), res, error);
+    if (!response)
+        return FALSE;
+
+    if (!(combinations = mm_fibocom_mc610_parse_gtrat_test_response (response, self, error)))
+        return FALSE;
+
+    return combinations;
+}
+
+static void
+load_supported_modes (MMIfaceModem        *self,
+                      GAsyncReadyCallback  callback,
+                      gpointer             user_data)
+{
+    mm_base_modem_at_command (
+        MM_BASE_MODEM (self),
+        "+GTRAT=?",
+        3,
+        TRUE,
+        callback,
+        user_data);
+}
+
+/*****************************************************************************/
+/* Load current modes (Modem interface) */
+
+static gboolean
+load_current_modes_finish (MMIfaceModem  *self,
+                           GAsyncResult  *res,
+                           MMModemMode   *allowed,
+                           MMModemMode   *preferred,
+                           GError       **error)
+{
+    const gchar *response;
+
+    response = mm_base_modem_at_command_finish (MM_BASE_MODEM (self), res, error);
+    if (!response)
+        return FALSE;
+
+    return mm_fibocom_mc610_parse_gtrat_read_response (response, self, allowed, preferred, error);
+}
+
+static void
+load_current_modes (MMIfaceModem        *self,
+                    GAsyncReadyCallback  callback,
+                    gpointer             user_data)
+{
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                              "+GTRAT?",
+                              3,
+                              FALSE,
+                              callback,
+                              user_data);
+}
+
+/*****************************************************************************/
+/* Set current modes (Modem interface) */
+
+static gboolean
+set_current_modes_finish (MMIfaceModem  *self,
+                          GAsyncResult  *res,
+                          GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+allowed_access_technology_update_ready (MMBroadbandModemFibocom *self,
+                                        GAsyncResult            *res,
+                                        GTask                   *task)
+{
+    GError *error = NULL;
+
+    mm_base_modem_at_command_finish (MM_BASE_MODEM (self), res, &error);
+    if (error)
+        g_task_return_error (task, error);
+    else
+        g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+set_current_modes (MMIfaceModem        *_self,
+                   MMModemMode          allowed,
+                   MMModemMode          preferred,
+                   GAsyncReadyCallback  callback,
+                   gpointer             user_data)
+{
+    MMBroadbandModemFibocomMc610 *self = MM_BROADBAND_MODEM_FIBOCOM_MC610 (_self);
+    GTask                        *task;
+    gchar                        *command;
+    GError                       *error = NULL;
+
+    task = g_task_new (self, NULL, callback, user_data);
+
+    mm_obj_dbg (self, "call set_current_modes, allowd: %d, preferred: %d", allowed, preferred);
+
+    command = mm_fibocom_mc610_build_gtrat_set_command (allowed, preferred, &error);
+
+    if (!command) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    mm_obj_dbg (self, "GTRAT: %s", command);
+
+    mm_base_modem_at_command (
+        MM_BASE_MODEM (self),
+        command,
+        30,
+        FALSE,
+        (GAsyncReadyCallback)allowed_access_technology_update_ready,
+        task);
+
+    g_free (command);
+}
+
+/*****************************************************************************/
+/* Load unlock retries (Modem interface) */
+
+static MMUnlockRetries *
+modem_load_unlock_retries_finish (MMIfaceModem *self,
+                                  GAsyncResult *res,
+                                  GError **error)
+{
+    const gchar *response;
+    guint pin1, puk1, pin2 ,puk2;
+
+    response = mm_base_modem_at_command_finish (MM_BASE_MODEM (self), res, error);
+    if (!response)
+        return NULL;
+
+    response = mm_strip_tag (response, "+TPIN:");
+    if (sscanf (response, " %d,%d,%d,%d", &pin1, &puk1, &pin2, &puk2) == 4) {
+        MMUnlockRetries *unlock_retries;
+        unlock_retries = mm_unlock_retries_new ();
+        mm_unlock_retries_set (unlock_retries, MM_MODEM_LOCK_SIM_PIN, pin1);
+        mm_unlock_retries_set (unlock_retries, MM_MODEM_LOCK_SIM_PUK, puk1);
+        mm_unlock_retries_set (unlock_retries, MM_MODEM_LOCK_SIM_PIN2, pin2);
+        mm_unlock_retries_set (unlock_retries, MM_MODEM_LOCK_SIM_PUK2, puk2);
+
+        return unlock_retries;
+    }
+
+    g_set_error (error,
+        MM_CORE_ERROR,
+        MM_CORE_ERROR_FAILED,
+        "Could not parse PIN retries results: '%s'",
+        response);
+    return NULL;
+}
+
+static void
+modem_load_unlock_retries (MMIfaceModem *self,
+                           GAsyncReadyCallback callback,
+                           gpointer user_data)
+{
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                              "+TPIN?",
+                              3,
+                              FALSE,
+                              callback,
+                              user_data);
+}
+
+/*****************************************************************************/
+/* SIM hot swap setup (Modem interface) */
+
+static void
+fibocom_sim_test_ready (MMBaseModem *_self,
+                        GAsyncResult *res,
+                        gpointer _data)
+{
+    MMBroadbandModemFibocomMc610 *self = MM_BROADBAND_MODEM_FIBOCOM_MC610 (_self);
+    GError *error = NULL;
+    const gchar *response;
+
+    response = mm_base_modem_at_command_finish (_self, res, &error);
+    if (!response) {
+        mm_obj_warn (self, "SIM has been removed during processing, abort");
+        g_object_unref (_self);
+        return;
+    }
+
+    // if no error, SIM is present
+    if (self->priv->sim_hot_swap_processing) {
+        mm_obj_warn (self, "SIM hot swap processing is already on-going, abort");
+        g_object_unref (_self);
+        return;
+    }
+
+    mm_obj_info (self, "SIM presence confirmed, triggering SIM card processing");
+    self->priv->sim_hot_swap_processing = TRUE;
+    mm_iface_modem_process_sim_event (MM_IFACE_MODEM (self));
+    g_object_unref (_self);
+}
+
+static gboolean
+fibocom_sim_wait_ready (MMBaseModem *self)
+{
+    mm_base_modem_at_command (self,
+                              "+CPIN?",
+                              30,
+                              FALSE,
+                              (GAsyncReadyCallback) fibocom_sim_test_ready,
+                              NULL);
+    return G_SOURCE_REMOVE;
+}
+
+static void
+mc610_sim_unsolicited_handler (MMPortSerialAt *port,
+                               GMatchInfo *match_info,
+                               MMBroadbandModemFibocomMc610 *self)
+{
+    gchar *sim_status;
+
+    sim_status = mm_get_string_unquoted_from_match_info (match_info, 1);
+    mm_obj_dbg (self, "MSMPD: SIM hot swap detected: '%s'", sim_status);
+
+    if (self->priv->sim_hot_swap_processing) {
+        mm_obj_warn (self, "SIM hot swap processing is already on-going, abort");
+        return;
+    }
+
+    if (g_ascii_strcasecmp (sim_status, "Removed") == 0) {
+        mm_obj_info (self, "SIM card has been removed, triggering SIM card processing");
+        self->priv->sim_hot_swap_processing = TRUE;
+        mm_iface_modem_process_sim_event (MM_IFACE_MODEM (self));
+    } else if (g_ascii_strcasecmp (sim_status, "Inserted") == 0) {
+        mm_obj_info (self, "SIM card has been inserted, check status in 1s");
+        // in case of insertion, we want to wait a bit before checking again
+        // if SIM is still present
+        g_timeout_add_seconds(1,
+                              (GSourceFunc) fibocom_sim_wait_ready,
+                              g_object_ref(MM_BASE_MODEM(self)));
+    } else {
+        mm_obj_warn (self, "(%s) MSMPD: unable to determine SIM insert status: %s",
+                     mm_port_get_device (MM_PORT (port)),
+                     sim_status);
+    }
+}
+
+static gboolean
+modem_setup_sim_hot_swap_finish (MMIfaceModem *self,
+                                 GAsyncResult *res,
+                                 GError **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+mc610_hot_swap_init_ready (MMBaseModem  *_self,
+                               GAsyncResult *res,
+                               GTask        *task)
+{
+    MMBroadbandModemFibocomMc610 *self = MM_BROADBAND_MODEM_FIBOCOM_MC610 (_self);
+    g_autoptr(GError)             error = NULL;
+    MMPortSerialAt               *ports[2];
+    guint                         i;
+
+    if (!mm_base_modem_at_command_finish (_self, res, &error)) {
+        g_prefix_error (&error, "Could not enable MSMPD: ");
+        g_task_return_error (task, g_steal_pointer (&error));
+        g_object_unref (task);
+        return;
+    }
+
+    mm_obj_dbg (self, "SIM hot swap detect successfully enabled");
+
+    ports[0] = mm_base_modem_peek_port_primary   (MM_BASE_MODEM (self));
+    ports[1] = mm_base_modem_peek_port_secondary (MM_BASE_MODEM (self));
+
+    for (i = 0; i < G_N_ELEMENTS (ports); i++) {
+        if (ports[i])
+            mm_port_serial_at_add_unsolicited_msg_handler (
+                ports[i],
+                self->priv->sim_hot_swap_regex,
+                (MMPortSerialAtUnsolicitedMsgFn) mc610_sim_unsolicited_handler,
+                self,
+                NULL);
+    }
+
+    if (!mm_broadband_modem_sim_hot_swap_ports_context_is_init(MM_BROADBAND_MODEM (self)) &&
+        !mm_broadband_modem_sim_hot_swap_ports_context_init (MM_BROADBAND_MODEM (self), &error))
+        mm_obj_warn (self, "failed to initialize SIM hot swap ports context: %s", error->message);
+
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+modem_setup_sim_hot_swap (MMIfaceModem *self,
+                          GAsyncReadyCallback callback,
+                          gpointer user_data)
+{
+    GTask *task;
+
+    mm_obj_dbg (self, "Enabling MSMPD for SIM hot swap detection");
+
+    task = g_task_new (self, NULL, callback, user_data);
+
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                              "+MSMPD=1",
+                              2,
+                              FALSE,
+                              (GAsyncReadyCallback) mc610_hot_swap_init_ready,
+                              task);
+}
+
+/*****************************************************************************/
+/* SIM hot swap cleanup (Modem interface) */
+
+static void
+modem_cleanup_sim_hot_swap (MMIfaceModem *self)
+{
+    mm_broadband_modem_sim_hot_swap_ports_context_reset (MM_BROADBAND_MODEM (self));
+}
