+// TODO: move this to helpers
+static GList *
+mm_fibocom_parse_mgauth_read_response(const gchar *reply,
+                                      GError **error)
+{
+    GError                *inner_error = NULL;
+    g_autoptr(GRegex)      r = NULL;
+    g_autoptr(GMatchInfo)  match_info = NULL;
+    GList                 *list = NULL;
+
+    if (!reply || !reply[0])
+        /* No APNs authentication configured, all done */
+        return NULL;
+
+    r = g_regex_new ("\\+MGAUTH:\\s*(\\d+),(\\d+)",
+        G_REGEX_DOLLAR_ENDONLY | G_REGEX_RAW,
+        0, NULL);
+    g_assert (r);
+
+    g_regex_match_full (r, reply, strlen (reply), 0, 0, &match_info, &inner_error);
+    while (!inner_error && g_match_info_matches (match_info)) {
+        guint mgauth_cid = 0;
+        guint auth_type = 0;
+
+        if (mm_get_uint_from_match_info (match_info, 1, &mgauth_cid) &&
+            mm_get_uint_from_match_info (match_info, 2, &auth_type)) {
+            ProfileAuth *auth = g_slice_new0 (ProfileAuth);
+            auth->profile_id = mgauth_cid;
+            auth->allowed_auth = mm_auth_type_from_fibocom_auth_type (auth_type);
+            list = g_list_prepend (list, auth);
+        } else {
+            inner_error = g_error_new (MM_CORE_ERROR,
+                MM_CORE_ERROR_FAILED,
+                "Failed to parse +MGAUTH response");
+            break;
+        }
+
+        g_match_info_next (match_info, &inner_error);
+    }
+
+    if (inner_error) {
+        profiles_auth_list_free (list);
+        g_propagate_error (error, inner_error);
+        g_prefix_error (error, "Couldn't properly parse list of PDP contexts authentication. ");
+        return NULL;
+    }
+
+    return g_list_sort (list, (GCompareFunc)profiles_auth_cmp);
+}
+
+static void
+profile_manager_mgauth_ready (MMBaseModem  *self,
+                              GAsyncResult *res,
+                              GTask        *task)
+{
+    const gchar                  *response;
+    ListProfilesContext          *ctx;
+    GError                       *error = NULL;
+    GList                        *l;
+    GList                        *auth_list = NULL;
+
+    ctx = g_task_get_task_data (task);
+
+    mm_obj_dbg_red (self, "profile_manager_mgauth_ready");
+
+    response = mm_base_modem_at_command_finish (self, res, &error);
+    if (!response) {
+        mm_obj_dbg_red (self, "couldn't load auth settings: %s", error->message);
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    auth_list = mm_fibocom_parse_mgauth_read_response (response, &error);
+    if (error) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    // time to merge authentication info into existing profiles
+    if (ctx->profiles) {
+        for (l = ctx->profiles; l; l = l->next) {
+            MM3gppProfile *profile = MM_3GPP_PROFILE (l->data);
+            ProfileAuth profile_tmp;
+            GList *auth = NULL;
+
+            profile_tmp.profile_id = mm_3gpp_profile_get_profile_id (profile);
+            auth = g_list_find_custom (auth_list, &profile_tmp, (GCompareFunc) profiles_auth_cmp);
+            if (auth) {
+                ProfileAuth *auth_data = auth->data;
+                mm_3gpp_profile_set_allowed_auth (profile, auth_data->allowed_auth);
+                if (auth_data->user)
+                    mm_3gpp_profile_set_user (profile, auth_data->user);
+                if (auth_data->password)
+                    mm_3gpp_profile_set_password (profile, auth_data->password);
+            }
+        }
+    }
+
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
