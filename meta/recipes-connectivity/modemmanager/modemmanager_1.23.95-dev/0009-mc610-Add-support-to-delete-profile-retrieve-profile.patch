+typedef struct {
+    gint                 profile_id;
+    MMBearerAllowedAuth  allowed_auth;
+    gchar               *user;
+    gchar               *password;
+} ProfileAuth;
+
+static void
+profiles_auth_free (ProfileAuth *auth)
+{
+    if (auth->user)
+        g_free (auth->user);
+    if (auth->password)
+        g_free (auth->password);
+    g_slice_free (ProfileAuth, auth);
+}
+
+static void
+profiles_auth_list_free (GList *list)
+{
+    g_list_free_full (list, (GDestroyNotify) profiles_auth_free);
+}
+
+static gint
+profiles_auth_cmp (ProfileAuth *a,
+                   ProfileAuth *b)
+{
+    return (a->profile_id - b->profile_id);
+}
