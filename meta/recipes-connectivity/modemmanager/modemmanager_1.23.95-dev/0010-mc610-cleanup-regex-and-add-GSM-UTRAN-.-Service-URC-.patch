From a29735d74916ff3bc8b62316eacad7887f80a6e5 Mon Sep 17 00:00:00 2001
From: Yannick Lanz <yannick.lanz@wifx.net>
Date: Wed, 2 Apr 2025 21:58:51 +0200
Subject: [PATCH 10/11] mc610: cleanup regex and add '+[GSM|UTRAN|...] Service'
 URC handler

---
 .../mm-broadband-modem-fibocom-mc610.c        | 39 +++++++++++++------
 1 file changed, 27 insertions(+), 12 deletions(-)

diff --git a/src/plugins/fibocom_mc610/mm-broadband-modem-fibocom-mc610.c b/src/plugins/fibocom_mc610/mm-broadband-modem-fibocom-mc610.c
index a0648bb4..f3153fd4 100644
--- a/src/plugins/fibocom_mc610/mm-broadband-modem-fibocom-mc610.c
+++ b/src/plugins/fibocom_mc610/mm-broadband-modem-fibocom-mc610.c
@@ -80,10 +80,6 @@ struct _MMBroadbandModemFibocomMc610Private {
     FeatureSupport  gtrndis_support;
     FeatureSupport  initial_eps_bearer_support;
 
-    /* Ignore +SIM READY */
-    GRegex         *sim_ready_regex;
-    /* Ignore +SIM DROP*/
-    GRegex         *sim_drop_regex;
     /* Ignore SIM hotswap msg, until ready */
     GRegex         *sim_hot_swap_regex;
 
@@ -1524,6 +1520,9 @@ setup_ports (MMBroadbandModem *_self)
     MMBroadbandModemFibocomMc610 *self = (MM_BROADBAND_MODEM_FIBOCOM_MC610 (_self));
     MMPortSerialAt              *ports[2];
     guint                        i;
+    g_autoptr(GRegex)            sim_ready_regex = NULL;
+    g_autoptr(GRegex)            sim_drop_regex = NULL;
+    g_autoptr(GRegex)            any_service_regex = NULL;
 
     /* Call parent's setup ports first always */
     MM_BROADBAND_MODEM_CLASS (mm_broadband_modem_fibocom_mc610_parent_class)->setup_ports (_self);
@@ -1536,16 +1535,38 @@ setup_ports (MMBroadbandModem *_self)
                       MM_PORT_SERIAL_AT_INIT_SEQUENCE, primary_init_sequence,
                       NULL);
 
+    /* Ignore +SIM READY */
+    sim_ready_regex = g_regex_new ("\\r\\n\\+SIM READY\\r\\n",
+                                   G_REGEX_RAW | G_REGEX_OPTIMIZE,
+                                   0,
+                                   NULL);
+
+    /* Ignore +SIM DROP*/
+    sim_drop_regex = g_regex_new ("\\r\\n\\+SIM DROP\\r\\n",
+                                  G_REGEX_RAW | G_REGEX_OPTIMIZE,
+                                  0,
+                                  NULL);
+
+    /* Ignore +[GSM|UTRAN|...] Service */
+    any_service_regex = g_regex_new ("\\r\\n\\+(.+?) Service\\r\\n",
+                                G_REGEX_RAW | G_REGEX_OPTIMIZE,
+                                0,
+                                NULL);
+
     for (i = 0; i < G_N_ELEMENTS (ports); i++) {
         if (!ports[i])
             continue;
         mm_port_serial_at_add_unsolicited_msg_handler (
             ports[i],
-            self->priv->sim_ready_regex,
+            sim_ready_regex,
             NULL, NULL, NULL);
         mm_port_serial_at_add_unsolicited_msg_handler (
             ports[i],
-            self->priv->sim_drop_regex,
+            sim_drop_regex,
+            NULL, NULL, NULL);
+        mm_port_serial_at_add_unsolicited_msg_handler (
+            ports[i],
+            any_service_regex,
             NULL, NULL, NULL);
         mm_port_serial_at_add_unsolicited_msg_handler (
             ports[i],
@@ -1584,10 +1605,6 @@ mm_broadband_modem_fibocom_mc610_init (MMBroadbandModemFibocomMc610 *self)
                                               MMBroadbandModemFibocomMc610Private);
 
     self->priv->gtrndis_support = FEATURE_SUPPORT_UNKNOWN;
-    self->priv->sim_ready_regex = g_regex_new ("\\r\\n\\+SIM READY\\r\\n",
-                                                G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
-    self->priv->sim_drop_regex = g_regex_new ("\\r\\n\\+SIM DROP\\r\\n",
-                                            G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
     self->priv->sim_hot_swap_regex = g_regex_new ("\\r\\n\\+SIM: (\\w+)\\r\\n",
                                             G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
 
@@ -1601,8 +1618,6 @@ finalize (GObject *object)
 {
     MMBroadbandModemFibocomMc610 *self = MM_BROADBAND_MODEM_FIBOCOM_MC610 (object);
 
-    g_regex_unref (self->priv->sim_ready_regex);
-    g_regex_unref (self->priv->sim_drop_regex);
     g_regex_unref (self->priv->sim_hot_swap_regex);
 
     if (self->priv->profile0) {
-- 
2.45.2

