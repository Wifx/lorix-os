From 98dbcb47db106d122a8714ef0671b69962fb73ec Mon Sep 17 00:00:00 2001
From: Yannick Lanz <yannick.lanz@wifx.net>
Date: Wed, 16 Apr 2025 22:30:30 +0200
Subject: [PATCH 3/3] gsm settings: fix EPS bearer password not handled if
 standard APN username/password not defined

Signed-off-by: Yannick Lanz <yannick.lanz@wifx.net>
---
 src/libnm-core-impl/nm-setting-gsm.c | 33 ++++++++++++++++++----------
 1 file changed, 21 insertions(+), 12 deletions(-)

diff --git a/src/libnm-core-impl/nm-setting-gsm.c b/src/libnm-core-impl/nm-setting-gsm.c
index 02e0e2369d..ad2d4a6e05 100644
--- a/src/libnm-core-impl/nm-setting-gsm.c
+++ b/src/libnm-core-impl/nm-setting-gsm.c
@@ -669,16 +669,26 @@ need_secrets(NMSetting *setting, gboolean check_rerequest)
     NMSettingGsmPrivate *priv    = NM_SETTING_GSM_GET_PRIVATE(setting);
     GPtrArray           *secrets = NULL;
 
-    if (!check_rerequest && priv->password && *priv->password)
-        return NULL;
-
-    if (priv->username) {
+    // check if we need to ask for the APN password
+    if (priv->username &&
+        (check_rerequest || !priv->password || !*priv->password)) {
         if (!(priv->password_flags & NM_SETTING_SECRET_FLAG_NOT_REQUIRED)) {
-            secrets = g_ptr_array_sized_new(1);
+            if (!secrets)
+                secrets = g_ptr_array_new();
             g_ptr_array_add(secrets, NM_SETTING_GSM_PASSWORD);
         }
     }
 
+    // check if we need to ask for the EPS bearer password
+    if (priv->initial_eps_username &&
+        (check_rerequest || !priv->initial_eps_password || !*priv->initial_eps_password)) {
+        if (!(priv->initial_eps_password_flags & NM_SETTING_SECRET_FLAG_NOT_REQUIRED)) {
+            if (!secrets)
+                secrets = g_ptr_array_new();
+            g_ptr_array_add(secrets, NM_SETTING_GSM_INITIAL_EPS_BEARER_PASSWORD);
+        }
+    }
+
     return secrets;
 }
 
@@ -1036,13 +1046,12 @@ nm_setting_gsm_class_init(NMSettingGsmClass *klass)
      *
      * Since: 1.52
      **/
-    _nm_setting_property_define_direct_secret_flags(
-        properties_override,
-        obj_properties,
-        NM_SETTING_GSM_INITIAL_EPS_BEARER_PASSWORD_FLAGS,
-        PROP_INITIAL_EPS_PASSWORD_FLAGS,
-        NMSettingGsmPrivate,
-        initial_eps_password_flags);
+    _nm_setting_property_define_direct_secret_flags(properties_override,
+                                                    obj_properties,
+                                                    NM_SETTING_GSM_INITIAL_EPS_BEARER_PASSWORD_FLAGS,
+                                                    PROP_INITIAL_EPS_PASSWORD_FLAGS,
+                                                    NMSettingGsmPrivate,
+                                                    initial_eps_password_flags);
 
     /**
      * NMSettingGsm:initial-eps-bearer-noauth:
-- 
2.45.2

