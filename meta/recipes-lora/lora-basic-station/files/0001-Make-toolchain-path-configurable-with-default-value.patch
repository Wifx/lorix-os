From 3c79127e4770c8dc9ddec189bc088fc71deebbde Mon Sep 17 00:00:00 2001
From: Yannick Lanz <yannick.lanz@wifx.net>
Date: Thu, 30 Jul 2026 18:03:07 +0200
Subject: [PATCH 1/6] Make toolchain path configurable with default value

---
 setup.gmk | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/setup.gmk b/setup.gmk
index d7c4363..89e4171 100644
--- a/setup.gmk
+++ b/setup.gmk
@@ -49,7 +49,7 @@ ARCH.kerlink = arm-klk-linux-gnueabi
 ARCH=${ARCH.${platform}}
 
 export TDfull := $(shell cd ${TD} && pwd)
-TOOLCHAIN=${HOME}/toolchain-${platform}
+TOOLCHAIN ?= ${HOME}/toolchain-${platform}
 
 
 ifeq (,$(wildcard ${TOOLCHAIN}))
@@ -65,11 +65,11 @@ else
 TOOLPREFIX=${TOOLCHAIN}/bin/${ARCH}-
 endif
 
-CC=${TOOLPREFIX}gcc
-LD=${TOOLPREFIX}ld
-AR=${TOOLPREFIX}ar
-OD=${TOOLPREFIX}objdump
-OC=${TOOLPREFIX}objcopy
+CC ?= ${TOOLPREFIX}gcc
+LD ?= ${TOOLPREFIX}ld
+AR ?= ${TOOLPREFIX}ar
+OD ?= ${TOOLPREFIX}objdump
+OC ?= ${TOOLPREFIX}objcopy
 
 ifeq (kerlink,${platform})
 # Needed for loader to find libmpfr.so.4
-- 
