Subject: [PATCH] Configure TCP_USER_TIMEOUT on TC sockets for reliable disconnection detection
---
Index: src/sys.c
<+>UTF-8
===================================================================
diff --git a/src/sys.c b/src/sys.c
--- a/src/sys.c	(revision ba4f85d80a438a5c2b659e568cd2d0f0de08e5a7)
+++ b/src/sys.c	(date 1784207328943)
@@ -632,20 +632,29 @@
 }
 
 void sys_keepAlive (int fd) {
-    str_t tag = "SO_KEEPALIVE";
     int v = TCP_KEEPALIVE_EN;
-    if( setsockopt(fd, SOL_SOCKET, SO_KEEPALIVE,  &v, sizeof(v)) == -1 ) goto err;
+    if( setsockopt(fd, SOL_SOCKET, SO_KEEPALIVE, &v, sizeof(v)) == -1 ) {
+        LOG(MOD_AIO|ERROR, "Failed to set SO_KEEPALIVE=%d: %s", v, strerror(errno));
+        return;
+    }
     if( v == 0 ) return;
-    tag = "TCP_KEEPCNT";
+
     v = TCP_KEEPALIVE_CNT;
-    if( setsockopt(fd, IPPROTO_TCP, TCP_KEEPCNT, &v, sizeof(v)) == -1 ) goto err;
-    tag = "TCP_KEEPIDLE";
+    if( setsockopt(fd, IPPROTO_TCP, TCP_KEEPCNT, &v, sizeof(v)) == -1 )
+        LOG(MOD_AIO|ERROR, "Failed to set TCP_KEEPCNT=%d: %s", v, strerror(errno));
+
     v = TCP_KEEPALIVE_IDLE;
-    if( setsockopt(fd, IPPROTO_TCP, TCP_KEEPIDLE, &v, sizeof(v)) == -1 ) goto err;
-    tag = "TCP_KEEPINTVL";
+    if( setsockopt(fd, IPPROTO_TCP, TCP_KEEPIDLE, &v, sizeof(v)) == -1 )
+        LOG(MOD_AIO|ERROR, "Failed to set TCP_KEEPIDLE=%d: %s", v, strerror(errno));
+
     v = TCP_KEEPALIVE_INTVL;
-    if( setsockopt(fd, IPPROTO_TCP, TCP_KEEPINTVL, &v, sizeof(v)) == -1 ) goto err;
-    return;
- err:
-    LOG(MOD_AIO|ERROR, "Failed to set %s=%d: %s", tag, v, strerror(errno));
+    if( setsockopt(fd, IPPROTO_TCP, TCP_KEEPINTVL, &v, sizeof(v)) == -1 )
+        LOG(MOD_AIO|ERROR, "Failed to set TCP_KEEPINTVL=%d: %s", v, strerror(errno));
+
+    v = TCP_USER_TIMEOUT_S;
+    if( v ) {
+        v *= 1000;
+        if( setsockopt(fd, IPPROTO_TCP, TCP_USER_TIMEOUT, &v, sizeof(v)) == -1 )
+            LOG(MOD_AIO|ERROR, "Failed to set TCP_USER_TIMEOUT=%d: %s", v, strerror(errno));
+    }
 }
Index: src/s2conf.h
IDEA additional info:
Subsystem: com.intellij.openapi.diff.impl.patch.CharsetEP
<+>UTF-8
===================================================================
diff --git a/src/s2conf.h b/src/s2conf.h
--- a/src/s2conf.h	(revision ba4f85d80a438a5c2b659e568cd2d0f0de08e5a7)
+++ b/src/s2conf.h	(date 1784207323848)
@@ -55,6 +55,7 @@
 #define DFLT_TCP_KEEPIDLE              "60"   // Connection idle time (in seconds) before sending keepalive probes
 #define DFLT_TCP_KEEPINTVL             "15"   // The time (in seconds) between individual keepalive probes
 #define DFLT_TCP_KEEPCNT                "4"   // The maximum number of keepalive probes sent before dropping the connection
+#define DFLT_TCP_USER_TIMEOUT        "120"   // Max time [s] TCP retransmits before giving up (matches keepalive total: idle+cnt*intvl)
 
 #define DFLT_MAX_RMTSH                    2   // The maximum number of keepalive probes sent before dropping the connection
 #define DFLT_BEACON_INTVL        "\"128s\""   // Time between beacons in microseconds
@@ -167,6 +168,7 @@
 CONF_PARAM(TCP_KEEPALIVE_IDLE  , u4    , u4      ,    DFLT_TCP_KEEPIDLE, "TCP keepalive TCP_KEEPIDLE [s]")
 CONF_PARAM(TCP_KEEPALIVE_INTVL , u4    , u4      ,   DFLT_TCP_KEEPINTVL, "TCP keepalive TCP_KEEPINTVL [s]")
 CONF_PARAM(TCP_KEEPALIVE_CNT   , u4    , u4      ,     DFLT_TCP_KEEPCNT, "TCP keepalive TCP_KEEPCNT")
+CONF_PARAM(TCP_USER_TIMEOUT_S  , u4    , u4      , DFLT_TCP_USER_TIMEOUT, "TCP user timeout [s]")
 CONF_PARAM(MAX_JOINEUI_RANGES  , u4    , u4      ,                 "10", "max ranges to suppress unwanted join requests")
 CONF_PARAM(CUPS_CONN_TIMEOUT   , ustime, tspan_s ,            "\"60s\"", "connection timeout")
 CONF_PARAM(CUPS_OKSYNC_INTV    , ustime, tspan_h ,            "\"24h\"", "regular check-in with CUPS for updates")
