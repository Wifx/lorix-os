-            LOG(MOD_SYN|WARNING, "Repeated excessive clock drifts between MCU/SX130X#%d (%d retries): %.1fppm (threshold %.1fppm)",
-                txunit, stats->excessive_drift_cnt, drift_ppm/fPPM_SCALE, stats->drift_thres/fPPM_SCALE);
+            sL_t dxp = curr->xtime - prev.xtime;
+            int drift_vs_prev_ppm = (prev.xtime && dxp > 0)
+                ? encodeDriftPPM( (double)(curr->ustime - prev.ustime)/(double)dxp )
+                : 0;
+            LOG(MOD_SYN|WARNING, "Repeated excessive clock drifts between MCU/SX130X#%d (%d retries): %.1fppm (threshold %.1fppm) vs prev=%.1fppm dt_last=%.1fms",
+                txunit, stats->excessive_drift_cnt, drift_ppm/fPPM_SCALE, stats->drift_thres/fPPM_SCALE,
+                drift_vs_prev_ppm/fPPM_SCALE, dus/1000.0);
+        }
+        if( (stats->excessive_drift_cnt % REBASE_RETRIES) == 0 ) {
+            // Blind on purpose: a poisoned reference never looks excessive against itself,
+            // so waiting for a "better" sample can stall indefinitely. Advancing regardless
+            // bounds the damage to REBASE_RETRIES*TIMESYNC_RADIO_INTV/2, whatever the cause.
+            *last = *curr;
         }
         if( stats->excessive_drift_cnt >= 2*QUICK_RETRIES )
             stats->drift_thres = MAX_MCU_DRIFT_THRES;  // reset - we might be stuck on a very low value
@@ -579,6 +594,7 @@ void ts_iniTimesync () {
     lastReport = 0;
     sum_mcu_drifts = 0;
     memset(timesyncs, 0, sizeof(timesyncs));
+    memset(prevSamples, 0, sizeof(prevSamples));
