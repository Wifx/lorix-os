+        gain_param(8, 0, 8),
+        gain_param(9, 0, 9),
+        gain_param(10, 0, 10),
+        gain_param(11, 0, 11),
+        gain_param(12, 0, 12),
+        gain_param(13, 0, 13),
+        gain_param(14, 0, 14),
+        gain_param(15, 0, 15),
+        gain_param(16, 0, 16),
+        gain_param(17, 0, 18),
+        gain_param(18, 0, 19),
+        gain_param(19, 1, 0),
+        gain_param(20, 1, 1),
+        gain_param(21, 1, 2),
+        gain_param(22, 1, 3),
+        gain_param(23, 1, 4),
+        gain_param(24, 1, 5),
+        gain_param(25, 1, 7),
+        gain_param(26, 1, 9),
+        gain_param(27, 1, 14),
+    ];
+}
+
+fn gain_param(rf_power: i8, pa: u8, pwr_idx: u8) -> hal::TxGainConfig {
+    hal::TxGainConfig {
