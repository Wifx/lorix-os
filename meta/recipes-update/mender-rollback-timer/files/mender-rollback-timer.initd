#!/sbin/openrc-run
# Copyright (c) 2026, Wifx SA <info@wifx.net>
# All rights reserved.

name="Mender Rollback Timer"
description="Rollback the update and reboots the device if a Mender update is not committed within a timeout"

# Settings from /etc/conf.d/mender-rollback-timer
: ${MENDER_ROLLBACK_TIMEOUT:=7200}
: ${MENDER_ROLLBACK_ENABLED:=false}

command="/usr/sbin/mender-rollback-timer.sh"
command_args="${MENDER_ROLLBACK_TIMEOUT}"
pidfile="/run/${RC_SVCNAME}.pid"

depend() {
    need localmount
    after bootmisc
    use logger
}

start() {
    # Only start if auto-rollback is enabled
    if [ "${MENDER_ROLLBACK_ENABLED}" != "true" ]; then
        einfo "Auto-rollback is disabled, skipping"
        return 0
    fi

    # Only start if an upgrade is actually pending
    if [ "$(fw_printenv -n upgrade_available 2>/dev/null)" != "1" ]; then
        einfo "No pending upgrade, skipping"
        return 0
    fi

    ebegin "Starting ${name}"
    start-stop-daemon --start \
        --background \
        --make-pidfile --pidfile "${pidfile}" \
        --exec "${command}" \
        -- ${command_args}
    eend $?
}

stop() {
    if [ ! -f "${pidfile}" ]; then
        return 0
    fi

    ebegin "Stopping ${name}"
    start-stop-daemon --stop --pidfile "${pidfile}"
    eend $?
}
